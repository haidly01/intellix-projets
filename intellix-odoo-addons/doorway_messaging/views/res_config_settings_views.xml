<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_messaging" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.messaging</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Messaging IntelliX" name="doorway_messaging">
                    <block title="API Messaging">
                        <setting string="Claude API">
                            <field name="messaging_claude_api_key" password="True"/>
                        </setting>
                        <setting string="Twilio">
                            <field name="messaging_twilio_account_sid"/>
                            <field name="messaging_twilio_auth_token" password="True"/>
                            <field name="messaging_twilio_sms_from"/>
                            <field name="messaging_twilio_whatsapp_from"/>
                            <field name="messaging_twilio_messaging_service_sid"/>
                            <field name="messaging_twilio_whatsapp_messaging_service_sid"/>
                        </setting>
                        <setting string="LinkedIn OAuth">
                            <field name="messaging_linkedin_client_id"/>
                            <field name="messaging_linkedin_client_secret" password="True"/>
                        </setting>
                        <setting string="n8n WhatsApp (DEV)">
                            <field name="messaging_n8n_wa_send_url"/>
                            <field name="messaging_n8n_wa_bulk_url"/>
                            <field name="messaging_n8n_wa_inbound_url"/>
                        </setting>
                        <setting string="Google OAuth (GMB)">
                            <field name="messaging_google_client_id"/>
                            <field name="messaging_google_client_secret" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
