<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doorway_wa_log_tree" model="ir.ui.view">
        <field name="name">doorway.wa.log.tree</field>
        <field name="model">doorway.wa.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="direction"/>
                <field name="phone"/>
                <field name="statut"/>
                <field name="provider"/>
                <field name="lead_id"/>
                <field name="user_id"/>
                <field name="external_sid"/>
            </list>
        </field>
    </record>

    <record id="view_doorway_wa_log_form" model="ir.ui.view">
        <field name="name">doorway.wa.log.form</field>
        <field name="model">doorway.wa.log</field>
        <field name="arch" type="xml">
            <form string="Log WhatsApp">
                <sheet>
                    <group>
                        <field name="direction"/>
                        <field name="statut"/>
                        <field name="provider"/>
                        <field name="phone"/>
                        <field name="lead_id"/>
                        <field name="partner_id"/>
                        <field name="user_id"/>
                        <field name="external_sid"/>
                        <field name="n8n_execution_id"/>
                    </group>
                    <group>
                        <field name="body"/>
                        <field name="error_message"/>
                        <field name="payload_json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_doorway_wa_log" model="ir.actions.act_window">
        <field name="name">WhatsApp (logs)</field>
        <field name="res_model">doorway.wa.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_wa_logs"
              name="WhatsApp (logs)"
              parent="doorway_messaging.menu_messaging_root"
              action="action_doorway_wa_log"
              sequence="35"/>
</odoo>
