<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_vicidial_workstation" model="ir.actions.client">
        <field name="name">Mon poste d'appels</field>
        <field name="tag">vicidial_workstation_action</field>
    </record>

    <record id="action_vicidial_callbacks_calendar" model="ir.actions.act_window">
        <field name="name">Mes rappels</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="domain">['|', ('name', 'ilike', 'Rappel Appels'), ('name', 'ilike', 'Rappel VICIdial')]</field>
        <field name="context">{'default_name': 'Rappel Appels'}</field>
    </record>

    <record id="view_vicidial_agent_session_list" model="ir.ui.view">
        <field name="name">doorway.vicidial.agent.session.list</field>
        <field name="model">doorway.vicidial.agent.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="user_id"/>
                <field name="campaign_id"/>
                <field name="state"/>
                <field name="nb_appels"/>
                <field name="nb_qualifies"/>
                <field name="duree_travail_secondes"/>
            </list>
        </field>
    </record>

    <record id="action_vicidial_agent_sessions" model="ir.actions.act_window">
        <field name="name">Sessions agents d'appels</field>
        <field name="res_model">doorway.vicidial.agent.session</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
