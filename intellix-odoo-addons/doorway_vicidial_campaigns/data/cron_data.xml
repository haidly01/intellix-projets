<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_vicidial_sync_campaigns" model="ir.cron">
        <field name="name">Appels: sync campagnes actives</field>
        <field name="model_id" ref="doorway_vicidial_campaigns.model_doorway_campaign"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_all_campaigns()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_vicidial_sync_call_logs" model="ir.cron">
        <field name="name">Appels: sync journal appels</field>
        <field name="model_id" ref="doorway_vicidial_campaigns.model_doorway_campaign"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_call_logs()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_enrich_call_logs" model="ir.cron">
        <field name="name">Appels: enrichir enregistrements (async)</field>
        <field name="model_id" ref="doorway_vicidial_campaigns.model_doorway_call_log"/>
        <field name="state">code</field>
        <field name="code">model.cron_enrich_recent_call_logs()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
