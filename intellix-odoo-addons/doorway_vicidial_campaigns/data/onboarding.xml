<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_vicidial_app_home" model="ir.actions.server">
        <field name="name">Appels</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">action = env['doorway.onboarding.service'].action_open_home('vicidial_call_center')</field>
    </record>

    <record id="action_vicidial_onboarding_wizard" model="ir.actions.act_window">
        <field name="name">Visite guidée — Agent call center</field>
        <field name="res_model">doorway.onboarding.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_tour_code': 'vicidial_call_center'}</field>
    </record>
</odoo>
