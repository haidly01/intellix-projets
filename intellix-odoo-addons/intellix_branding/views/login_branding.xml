<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sans website : login classique Odoo -->
    <!-- Évite le double POST (CSRF invalide après 1ère connexion réussie) -->
    <template id="web_login_intellix_antidouble" inherit_id="web.login" name="Intellix — Login anti double-submit">
        <xpath expr="//form[@data-captcha='login']" position="attributes">
            <attribute name="onsubmit">this.action = '/web/login' + location.hash; if (this.dataset.ixSent) { return false; } this.dataset.ixSent = '1'; var btn = this.querySelector('button[type=submit]'); if (btn) { btn.disabled = true; } return true;</attribute>
        </xpath>
    </template>

    <template id="login_layout_intellix" inherit_id="web.login_layout" name="Intellix — Login layout">
        <xpath expr="//t[@t-set='html_data']" position="replace">
            <t t-set="html_data" t-value="{'style': 'height: 100%;', 'data-bs-theme': 'dark'}"/>
        </xpath>
        <xpath expr="//t[@t-set='body_classname']" position="replace">
            <t t-set="body_classname" t-value="'bg-100 ix-login'"/>
        </xpath>
        <xpath expr="//div[hasclass('text-center') and hasclass('pb-3')]" position="replace">
            <t t-call="intellix_branding.intellix_brand_header"/>
        </xpath>
        <xpath expr="//a[contains(@href,'odoo.com')]" position="replace"/>
    </template>

    <template id="intellix_brand_header" name="Intellix — En-tête marque">
        <t t-set="ix_host" t-value="request.httprequest.host or ''"/>
        <t t-if="'jasonthomas' in ix_host">
            <div class="ix-brand-block pb-3 mb-4">
                <div class="ix-brand-icon" aria-hidden="true">
                    <span>JT</span>
                </div>
                <p class="ix-brand-name">Jason Thomas</p>
                <p class="ix-brand-baseline">Assurance · CRM</p>
            </div>
        </t>
        <t t-else="">
            <div class="ix-brand-block pb-3 mb-4">
                <div class="ix-brand-icon" aria-hidden="true">
                    <span>IX</span>
                </div>
                <p class="ix-brand-name">intell<span class="ix-accent">ix</span></p>
                <p class="ix-brand-baseline">Intelligence · Amplifiée</p>
            </div>
        </t>
    </template>

</odoo>
