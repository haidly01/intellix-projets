<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_renovation_ai_prompt_tree" model="ir.ui.view">
        <field name="name">renovation.ai.prompt.list</field>
        <field name="model">renovation.ai.prompt</field>
        <field name="arch" type="xml">
            <list string="Prompts IA">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_renovation_ai_prompt_form" model="ir.ui.view">
        <field name="name">renovation.ai.prompt.form</field>
        <field name="model">renovation.ai.prompt</field>
        <field name="arch" type="xml">
            <form string="Prompt IA">
                <header>
                    <button name="action_reset_default" type="object"
                            string="Réinitialiser au défaut" class="btn-secondary"
                            confirm="Remplacer ce prompt par la valeur par défaut ?"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code" readonly="1"/>
                        <field name="active"/>
                    </group>
                    <group string="Prompt système">
                        <field name="system_prompt" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_renovation_ai_prompt" model="ir.actions.act_window">
        <field name="name">Prompts IA</field>
        <field name="res_model">renovation.ai.prompt</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_renovation_ai_prompt"
              name="Prompts IA"
              parent="menu_renovation_root"
              action="action_renovation_ai_prompt"
              groups="base.group_system"
              sequence="91"/>
</odoo>
