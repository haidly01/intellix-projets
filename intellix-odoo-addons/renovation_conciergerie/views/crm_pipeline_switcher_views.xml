<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        En-tête kanban CRM :
        - « Nouvelle opportunité » (bleu) ouvre le formulaire complet
        - Boutons pipeline toujours visibles (display="always")
    -->
    <record id="crm_case_kanban_view_leads_pipeline_switcher" model="ir.ui.view">
        <field name="name">crm.lead.kanban.pipeline.switcher</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <header>
                    <button name="action_create_opportunity" type="object"
                            string="Nouvelle opportunité" display="always"
                            class="btn-primary o_doorway_new_opportunity_btn"
                            groups="sales_team.group_sale_salesman"/>
                    <button name="action_open_all_crm_pipelines" type="object"
                            string="Tous"
                            class="btn-secondary o_doorway_pipeline_btn o_doorway_pipeline_btn_all"
                            display="always"
                            groups="sales_team.group_sale_salesman"/>
                    <button name="action_switch_crm_pipeline" type="object"
                            string="Rénovation"
                            class="btn-secondary o_doorway_pipeline_btn"
                            display="always"
                            context="{'renovation_pipeline_xmlid': 'renovation_conciergerie.crm_team_renovation'}"
                            groups="renovation_conciergerie.group_pipeline_tab_renovation"/>
                    <button name="action_switch_crm_pipeline" type="object"
                            string="Immobilier"
                            class="btn-secondary o_doorway_pipeline_btn"
                            display="always"
                            context="{'renovation_pipeline_xmlid': 'renovation_conciergerie.crm_team_immobilier'}"
                            groups="renovation_conciergerie.group_pipeline_tab_immobilier"/>
                    <button name="action_switch_crm_pipeline" type="object"
                            string="Marketing"
                            class="btn-secondary o_doorway_pipeline_btn"
                            display="always"
                            context="{'renovation_pipeline_xmlid': 'renovation_conciergerie.crm_team_marketing'}"
                            groups="renovation_conciergerie.group_pipeline_tab_marketing"/>
                    <button name="action_switch_crm_pipeline" type="object"
                            string="Driven"
                            class="btn-secondary o_doorway_pipeline_btn"
                            display="always"
                            context="{'renovation_pipeline_xmlid': 'renovation_conciergerie.crm_team_driven'}"
                            groups="renovation_conciergerie.group_pipeline_tab_driven"/>
                    <button name="action_switch_crm_pipeline" type="object"
                            string="Doorway Clients"
                            class="btn-secondary o_doorway_pipeline_btn"
                            display="always"
                            context="{'renovation_pipeline_xmlid': 'renovation_conciergerie.crm_team_doorway_b2b'}"
                            groups="renovation_conciergerie.group_pipeline_tab_doorway_b2b"/>
                    <button name="action_switch_crm_pipeline" type="object"
                            string="Assurance"
                            class="btn-secondary o_doorway_pipeline_btn"
                            display="always"
                            context="{'renovation_pipeline_xmlid': 'renovation_conciergerie.crm_team_assurance'}"
                            groups="renovation_conciergerie.group_pipeline_tab_assurance"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_crm_lead_kanban_pipeline_switcher" model="ir.ui.view">
        <field name="name">crm.lead.kanban.leads.pipeline.switcher</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_lead_kanban"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <header>
                    <button name="action_create_opportunity" type="object"
                            string="Nouvelle opportunité" display="always"
                            class="btn-primary o_doorway_new_opportunity_btn"
                            groups="sales_team.group_sale_salesman"/>
                    <button name="action_open_all_crm_pipelines" type="object"
                            string="Tous"
                            class="btn-secondary o_doorway_pipeline_btn o_doorway_pipeline_btn_all"
                            display="always"
                            groups="sales_team.group_sale_salesman"/>
                    <button name="action_switch_crm_pipeline" type="object"
                            string="Rénovation"
                            class="btn-secondary o_doorway_pipeline_btn"
                            display="always"
                            context="{'renovation_pipeline_xmlid': 'renovation_conciergerie.crm_team_renovation'}"
                            groups="renovation_conciergerie.group_pipeline_tab_renovation"/>
                    <button name="action_switch_crm_pipeline" type="object"
                            string="Immobilier"
                            class="btn-secondary o_doorway_pipeline_btn"
                            display="always"
                            context="{'renovation_pipeline_xmlid': 'renovation_conciergerie.crm_team_immobilier'}"
                            groups="renovation_conciergerie.group_pipeline_tab_immobilier"/>
                    <button name="action_switch_crm_pipeline" type="object"
                            string="Marketing"
                            class="btn-secondary o_doorway_pipeline_btn"
                            display="always"
                            context="{'renovation_pipeline_xmlid': 'renovation_conciergerie.crm_team_marketing'}"
                            groups="renovation_conciergerie.group_pipeline_tab_marketing"/>
                    <button name="action_switch_crm_pipeline" type="object"
                            string="Driven"
                            class="btn-secondary o_doorway_pipeline_btn"
                            display="always"
                            context="{'renovation_pipeline_xmlid': 'renovation_conciergerie.crm_team_driven'}"
                            groups="renovation_conciergerie.group_pipeline_tab_driven"/>
                    <button name="action_switch_crm_pipeline" type="object"
                            string="Doorway Clients"
                            class="btn-secondary o_doorway_pipeline_btn"
                            display="always"
                            context="{'renovation_pipeline_xmlid': 'renovation_conciergerie.crm_team_doorway_b2b'}"
                            groups="renovation_conciergerie.group_pipeline_tab_doorway_b2b"/>
                    <button name="action_switch_crm_pipeline" type="object"
                            string="Assurance"
                            class="btn-secondary o_doorway_pipeline_btn"
                            display="always"
                            context="{'renovation_pipeline_xmlid': 'renovation_conciergerie.crm_team_assurance'}"
                            groups="renovation_conciergerie.group_pipeline_tab_assurance"/>
                </header>
            </xpath>
        </field>
    </record>

</odoo>
