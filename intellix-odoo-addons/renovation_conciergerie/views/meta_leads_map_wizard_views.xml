<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_renovation_meta_leads_map_editor_form" model="ir.ui.view">
        <field name="name">renovation.meta.leads.map.editor.form</field>
        <field name="model">renovation.meta.leads.map.editor</field>
        <field name="arch" type="xml">
            <form string="Mapping Meta Lead Ads">
                <group>
                    <p class="text-muted">
                        Éditez les <code>page_id</code> et le routage (immo / énergie / haidly).
                        Enregistrer met à jour le hub n8n et la synchro Énergie Pro.
                    </p>
                </group>
                <field name="map_json" nolabel="1" placeholder="{ ... }"/>
                <footer>
                    <button name="action_save" type="object" string="Enregistrer" class="btn-primary"/>
                    <button name="action_reset_default" type="object"
                            string="Réinitialiser modèle Doorway" class="btn-secondary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_renovation_meta_leads_map_editor" model="ir.actions.act_window">
        <field name="name">Mapping Meta Lead Ads</field>
        <field name="res_model">renovation.meta.leads.map.editor</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
