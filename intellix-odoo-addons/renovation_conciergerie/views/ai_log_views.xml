<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_renovation_ai_log_tree" model="ir.ui.view">
        <field name="name">renovation.ai.log.list</field>
        <field name="model">renovation.ai.log</field>
        <field name="arch" type="xml">
            <list string="Journal des appels IA" create="false" edit="false"
                  decoration-danger="status == 'error'" decoration-success="status == 'success'">
                <field name="create_date" string="Date"/>
                <field name="user_id"/>
                <field name="purpose"/>
                <field name="ai_provider"/>
                <field name="model_used"/>
                <field name="input_tokens"/>
                <field name="output_tokens"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_renovation_ai_log_form" model="ir.ui.view">
        <field name="name">renovation.ai.log.form</field>
        <field name="model">renovation.ai.log</field>
        <field name="arch" type="xml">
            <form string="Appel IA" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Date"/>
                            <field name="user_id"/>
                            <field name="purpose"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="ai_provider"/>
                            <field name="model_used"/>
                            <field name="input_tokens"/>
                            <field name="output_tokens"/>
                        </group>
                    </group>
                    <group string="Requête">
                        <field name="request_summary" nolabel="1"/>
                    </group>
                    <group string="Réponse">
                        <field name="response_summary" nolabel="1"/>
                    </group>
                    <group string="Erreur" invisible="status != 'error'">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_renovation_ai_log" model="ir.actions.act_window">
        <field name="name">Journal des appels IA</field>
        <field name="res_model">renovation.ai.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_renovation_ai_log"
              name="Journal IA"
              parent="menu_renovation_root"
              action="action_renovation_ai_log"
              groups="base.group_system"
              sequence="90"/>
</odoo>
