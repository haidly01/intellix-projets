<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_renovation_service_category_tree" model="ir.ui.view">
        <field name="name">renovation.service.category.tree</field>
        <field name="model">renovation.service.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_renovation_service_category_form" model="ir.ui.view">
        <field name="name">renovation.service.category.form</field>
        <field name="model">renovation.service.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="parent_id"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group string="Sous-catégories">
                        <field name="child_ids" nolabel="1">
                            <list>
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="code"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_renovation_service_category" model="ir.actions.act_window">
        <field name="name">Catégories de services</field>
        <field name="res_model">renovation.service.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_renovation_root"
              name="Partenaires"
              sequence="50"
              groups="base.group_erp_manager"/>

    <menuitem id="menu_renovation_config"
              name="Configuration"
              parent="menu_renovation_root"
              sequence="90"
              groups="base.group_erp_manager"/>

    <menuitem id="menu_renovation_service_category"
              name="Catégories de services"
              parent="menu_renovation_config"
              action="action_renovation_service_category"
              sequence="10"
              groups="base.group_system"/>

</odoo>
