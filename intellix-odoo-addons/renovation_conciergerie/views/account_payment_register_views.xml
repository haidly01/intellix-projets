<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form_intellix" model="ir.ui.view">
        <field name="name">account.payment.register.form.intellix</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <field name="amount" position="attributes">
                <attribute name="readonly">not can_edit_wizard</attribute>
                <attribute name="placeholder">Solde facture (modifiable)</attribute>
            </field>
            <field name="currency_id" position="attributes">
                <attribute name="readonly">not can_edit_wizard</attribute>
            </field>
        </field>
    </record>
</odoo>
