<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_twilio_calls" model="ir.ui.view">
        <field name="name">crm.lead.form.twilio.calls</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button name="action_call_contact_via_twilio"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-phone"
                        string="Twilio"
                        invisible="type == 'lead'"
                        title="Appeler le contact via Twilio"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Appels Twilio">
                    <field name="twilio_call_log_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="create_date" string="Date"/>
                            <field name="phone_number"/>
                            <field name="status"/>
                            <field name="duration_seconds"/>
                            <field name="recording_status"/>
                            <field name="recording_url" widget="url"/>
                            <field name="twilio_call_sid"/>
                        </list>
                    </field>
                </page>
                <page string="Historique appels (legacy)">
                    <field name="retell_call_log_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="create_date" string="Date"/>
                            <field name="phone_number"/>
                            <field name="status"/>
                            <field name="duration_seconds"/>
                            <field name="transcript_url" widget="url"/>
                            <field name="recording_url" widget="url"/>
                            <field name="retell_call_id" string="ID appel"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
