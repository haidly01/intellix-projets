<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- CRON : auto-acceptation des leads sans réponse après 24h -->
    <record id="cron_auto_accept_24h" model="ir.cron">
        <field name="name">Rénovation : auto-acceptation des leads après 24h</field>
        <field name="model_id" ref="model_renovation_lead_service_assignment"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_accept_24h()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Liste des demandes de crédit (admin) -->
    <record id="view_credit_request_tree" model="ir.ui.view">
        <field name="name">renovation.credit.request.tree</field>
        <field name="model">renovation.lead.service.assignment</field>
        <field name="arch" type="xml">
            <list string="Demandes de crédit" create="false"
                  decoration-warning="status == 'credit_requested'">
                <field name="credit_request_date"/>
                <field name="partner_id"/>
                <field name="lead_id"/>
                <field name="service_category_id"/>
                <field name="status"/>
                <button name="action_validate_credit" type="object"
                        string="Valider" class="btn-success"
                        invisible="status != 'credit_requested'"/>
                <button name="action_reject_credit" type="object"
                        string="Refuser" class="btn-danger"
                        invisible="status != 'credit_requested'"/>
            </list>
        </field>
    </record>

    <!-- Formulaire d'une demande de crédit (admin) -->
    <record id="view_credit_request_form" model="ir.ui.view">
        <field name="name">renovation.credit.request.form</field>
        <field name="model">renovation.lead.service.assignment</field>
        <field name="arch" type="xml">
            <form string="Demande de crédit" create="false">
                <header>
                    <button name="action_validate_credit" type="object"
                            string="Valider le crédit" class="btn-primary"
                            invisible="status != 'credit_requested'"/>
                    <button name="action_reject_credit" type="object"
                            string="Refuser" class="btn-secondary"
                            invisible="status != 'credit_requested'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Attribution">
                            <field name="partner_id" readonly="1"/>
                            <field name="lead_id" readonly="1"/>
                            <field name="service_category_id" readonly="1"/>
                            <field name="lead_consumed" readonly="1"/>
                        </group>
                        <group string="Crédit">
                            <field name="credit_request_date" readonly="1"/>
                            <field name="credit_validated_by" readonly="1"/>
                            <field name="credit_decision_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Tentatives de contact (non rejoint)">
                        <group>
                            <field name="contact_attempt_1_date" readonly="1"/>
                            <field name="contact_attempt_1_method" readonly="1"/>
                            <field name="contact_attempt_2_date" readonly="1"/>
                            <field name="contact_attempt_2_method" readonly="1"/>
                            <field name="contact_attempt_3_date" readonly="1"/>
                            <field name="contact_attempt_3_method" readonly="1"/>
                        </group>
                        <group>
                            <field name="refusal_reason" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_renovation_credit_requests" model="ir.actions.act_window">
        <field name="name">Demandes de crédit</field>
        <field name="res_model">renovation.lead.service.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', 'in', ['credit_requested', 'credited'])]</field>
    </record>

    <menuitem id="menu_renovation_credit_requests"
              name="Demandes de crédit"
              parent="menu_renovation_root"
              action="action_renovation_credit_requests"
              sequence="15"
              groups="base.group_system"/>

</odoo>
