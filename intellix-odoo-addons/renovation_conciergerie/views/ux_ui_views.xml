<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= CRM ================= -->
    <!-- Décorations liste opportunités -->
    <record id="crm_oppor_tree_ux" model="ir.ui.view">
        <field name="name">crm.lead.list.ux</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="activity_state" column_invisible="1"/>
                <field name="priority" column_invisible="1"/>
            </xpath>
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">activity_state == 'overdue'</attribute>
                <attribute name="decoration-warning">activity_state == 'today'</attribute>
                <attribute name="decoration-bf">priority == '3'</attribute>
            </xpath>
        </field>
    </record>

    <!-- Filtres rapides CRM -->
    <record id="crm_oppor_search_ux" model="ir.ui.view">
        <field name="name">crm.lead.search.ux</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="ux_hot" string="Chauds 🔥"
                        domain="[('priority', 'in', ['2', '3'])]"/>
                <filter name="ux_today" string="À relancer aujourd'hui"
                        domain="[('activity_state', '=', 'today')]"/>
                <filter name="ux_overdue" string="Activité en retard"
                        domain="[('activity_state', '=', 'overdue')]"/>
                <filter name="ux_no_activity" string="Sans activité"
                        domain="[('activity_state', '=', False)]"/>
            </xpath>
        </field>
    </record>

    <!-- Formulaire opportunité : alerte + ruban + KPI -->
    <record id="crm_oppor_form_ux" model="ir.ui.view">
        <field name="name">crm.lead.form.ux</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="activity_state != 'overdue'">
                    ⏰ Cette opportunité a une activité <b>en retard</b>.
                </div>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="activity_state" invisible="1"/>
                <widget name="web_ribbon" title="Gagné" bg_color="text-bg-success"
                        invisible="probability &lt; 100"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="kpi_level" invisible="1"/>
                <field name="kpi_text" widget="badge" nolabel="1"
                       invisible="kpi_level == 'none'"
                       decoration-success="kpi_level == 'high'"
                       decoration-warning="kpi_level == 'medium'"
                       decoration-danger="kpi_level == 'low'"/>
            </xpath>
        </field>
    </record>

    <!-- ================= VENTES ================= -->
    <record id="sale_order_tree_ux" model="ir.ui.view">
        <field name="name">sale.order.list.ux</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="invoice_status" column_invisible="1"/>
                <field name="margin" optional="show" widget="monetary"
                       decoration-success="margin &gt; 0" decoration-danger="margin &lt; 0"/>
                <field name="margin_percent" optional="hide" widget="percentage"
                       decoration-success="margin_percent &gt; 0" decoration-danger="margin_percent &lt; 0"/>
            </xpath>
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-info">invoice_status == 'to invoice'</attribute>
                <attribute name="decoration-muted">state == 'cancel'</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_quotation_tree_ux" model="ir.ui.view">
        <field name="name">sale.quotation.list.ux</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-warning">state == 'sent'</attribute>
                <attribute name="decoration-muted">state == 'cancel'</attribute>
            </xpath>
        </field>
    </record>

    <!-- Filtres rapides Ventes -->
    <record id="sale_order_search_ux" model="ir.ui.view">
        <field name="name">sale.order.search.ux</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="ux_to_relance" string="Devis à relancer"
                        domain="[('state', '=', 'sent')]"/>
                <filter name="ux_to_invoice" string="À facturer"
                        domain="[('invoice_status', '=', 'to invoice')]"/>
                <filter name="ux_expired" string="Devis expiré"
                        domain="[('state', 'in', ['draft', 'sent']), ('validity_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="ux_late_delivery" string="Livraison en retard"
                        domain="[('state', '=', 'sale'), ('commitment_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
            </xpath>
        </field>
    </record>

    <!-- ================= PROJET ================= -->
    <!-- Décorations liste tâches -->
    <record id="project_task_tree_ux" model="ir.ui.view">
        <field name="name">project.task.list.ux</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="activity_state" column_invisible="1"/>
                <field name="priority" column_invisible="1"/>
            </xpath>
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">is_overdue == True</attribute>
                <attribute name="decoration-warning">activity_state == 'today'</attribute>
                <attribute name="decoration-bf">priority == '3'</attribute>
            </xpath>
        </field>
    </record>

    <!-- Filtres rapides Projet -->
    <record id="project_task_search_ux" model="ir.ui.view">
        <field name="name">project.task.search.ux</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="ux_overdue" string="En retard"
                        domain="[('is_overdue', '=', True)]"/>
                <filter name="ux_today" string="Échéance aujourd'hui"
                        domain="[('date_deadline', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('date_deadline', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter name="ux_week" string="Échéance cette semaine"
                        domain="[('date_deadline', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('date_deadline', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d 23:59:59'))]"/>
            </xpath>
        </field>
    </record>

    <!-- ================= KANBANS ================= -->
    <!-- CRM : badge "En retard" sur la carte -->
    <record id="crm_kanban_ux" model="ir.ui.view">
        <field name="name">crm.lead.kanban.ux</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="activity_state"/>
            </xpath>
            <xpath expr="//t[@t-name='card']" position="inside">
                <div t-if="record.activity_state.raw_value == 'overdue'" class="mt-1">
                    <span class="badge text-bg-danger">⏰ En retard</span>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Projet : badge "En retard" + jours de retard sur la carte tâche -->
    <record id="project_task_kanban_ux" model="ir.ui.view">
        <field name="name">project.task.kanban.ux</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="is_overdue"/>
                <field name="days_overdue"/>
            </xpath>
            <xpath expr="//t[@t-name='card']" position="inside">
                <div t-if="record.is_overdue.raw_value" class="mt-1">
                    <span class="badge text-bg-danger">⏰ En retard (<t t-esc="record.days_overdue.value"/> j)</span>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Projet : pastille de santé IA sur la carte projet -->
    <record id="project_kanban_ux" model="ir.ui.view">
        <field name="name">project.project.kanban.ux</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="ai_health"/>
            </xpath>
            <xpath expr="//t[@t-name='card']" position="inside">
                <div t-if="record.ai_health.raw_value and record.ai_health.raw_value != 'unknown'" class="mt-1">
                    <span t-if="record.ai_health.raw_value == 'on_track'" class="badge text-bg-success">
                        <t t-esc="record.ai_health.value"/>
                    </span>
                    <span t-if="record.ai_health.raw_value == 'at_risk'" class="badge text-bg-warning">
                        <t t-esc="record.ai_health.value"/>
                    </span>
                    <span t-if="record.ai_health.raw_value == 'critical'" class="badge text-bg-danger">
                        <t t-esc="record.ai_health.value"/>
                    </span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
