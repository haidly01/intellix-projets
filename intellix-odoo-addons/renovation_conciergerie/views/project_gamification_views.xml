<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_my_progress_list" model="ir.ui.view">
        <field name="name">project.my.progress.list</field>
        <field name="model">gamification.goal</field>
        <field name="arch" type="xml">
            <list string="Ma progression" create="false" edit="false" delete="false"
                  default_order="end_date asc">
                <field name="challenge_id"/>
                <field name="definition_id"/>
                <field name="current"/>
                <field name="target_goal"/>
                <field name="completeness" widget="progressbar"/>
                <field name="end_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'reached'"
                       decoration-info="state == 'inprogress'"
                       decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="action_project_my_progress" model="ir.actions.act_window">
        <field name="name">Ma progression</field>
        <field name="res_model">gamification.goal</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_project_my_progress_list"/>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_project_my_progress"
              name="Ma progression 🎯"
              parent="project.menu_main_pm"
              action="action_project_my_progress"
              groups="base.group_user"
              sequence="93"/>
</odoo>
