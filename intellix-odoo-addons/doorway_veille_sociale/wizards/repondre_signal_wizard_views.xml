<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repondre_signal_wizard_form" model="ir.ui.view">
        <field name="name">doorway.repondre.signal.wizard.form</field>
        <field name="model">doorway.repondre.signal.wizard</field>
        <field name="arch" type="xml">
            <form string="Répondre au signal">
                <group>
                    <field name="signal_id" invisible="1"/>
                    <field name="can_reply_api" invisible="1"/>
                    <field name="reply_api_source" invisible="1"/>
                    <group>
                        <field name="source"/>
                        <field name="plateforme"/>
                        <field name="titre"/>
                        <field name="resume"/>
                    </group>
                    <group>
                        <field name="url" widget="url" readonly="1"/>
                        <field name="reply_channel_hint" nolabel="1" readonly="1"/>
                        <field name="conversation_synced_at" readonly="1"/>
                    </group>
                </group>
                <div class="alert alert-warning mb-3" role="alert"
                     invisible="source != 'reddit' or can_reply_api">
                    <strong>Reddit — réponse manuelle</strong> — pour publier depuis Odoo,
                    configurez l'app Reddit dans
                    <b>Veille → Connexions &amp; sources → Reddit</b>
                    (Client ID, secret, refresh token), puis cliquez
                    <b>Tester Reddit</b>.
                </div>
                <div class="alert alert-warning mb-3" role="alert"
                     invisible="source != 'google_alerts'">
                    <strong>Alerte presse</strong> — Google a détecté un article
                    (ex. journal, blog). Ce n'est pas un commentaire Facebook/Reddit :
                    il n'y a pas de fil à synchroniser. Ouvrez l'article, agissez
                    (réponse éditoriale, LinkedIn, outreach), puis enregistrez votre
                    action ci-dessous.
                </div>
                <group string="Fil de conversation">
                    <div class="mb-2">
                        <button name="action_actualiser_conversation" type="object"
                                string="Actualiser la conversation" class="btn-secondary"/>
                    </div>
                    <field name="conversation_message_ids" nolabel="1" readonly="1">
                        <list decoration-info="direction == 'outbound'"
                              decoration-muted="direction == 'inbound'">
                            <field name="posted_at"/>
                            <field name="direction" widget="badge"
                                   decoration-info="direction == 'outbound'"
                                   decoration-success="direction == 'inbound'"/>
                            <field name="author_name"/>
                            <field name="body"/>
                            <field name="platform" optional="hide"/>
                        </list>
                    </field>
                    <div class="alert alert-info" role="status"
                         invisible="conversation_message_ids">
                        Cliquez sur <b>Actualiser la conversation</b> pour charger
                        les commentaires depuis Meta ou Reddit.
                    </div>
                </group>
                <group string="Votre réponse">
                    <div class="alert alert-info mb-2" role="status">
                        Répondre ne crée pas de lead CRM. Utilisez
                        <b>Créer un lead CRM</b> seulement si vous voulez une opportunité.
                    </div>
                    <field name="reponse_brouillon" nolabel="1"
                           placeholder="Rédigez votre réponse ici…"/>
                </group>
                <footer>
                    <button name="action_envoyer_reponse" type="object"
                            string="Envoyer via Meta" class="btn-primary"
                            invisible="reply_api_source != 'meta'"/>
                    <button name="action_envoyer_reponse" type="object"
                            string="Envoyer sur Reddit" class="btn-primary"
                            invisible="reply_api_source != 'reddit'"/>
                    <button name="action_ouvrir_source" type="object"
                            string="Ouvrir l'article ↗" class="btn-primary"
                            invisible="not url or source != 'google_alerts'"/>
                    <button name="action_ouvrir_source" type="object"
                            string="Ouvrir sur la plateforme ↗" class="btn-secondary"
                            invisible="not url or source == 'google_alerts'"/>
                    <button name="action_enregistrer_reponse" type="object"
                            string="Marquer répondu (manuel)" class="btn-secondary"/>
                    <button name="action_creer_lead" type="object"
                            string="Créer un lead CRM" class="btn-secondary"/>
                    <button name="action_planifier_tache" type="object"
                            string="Planifier une tâche" class="btn-secondary"/>
                    <button string="Fermer" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
