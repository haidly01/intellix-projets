<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reactivation_douce_wizard_form" model="ir.ui.view">
        <field name="name">doorway.reactivation.douce.wizard.form</field>
        <field name="model">doorway.reactivation.douce.wizard</field>
        <field name="arch" type="xml">
            <form string="Réactivation douce">
                <field name="signal_id" invisible="1"/>
                <field name="mode_api_disponible" invisible="1"/>
                <group>
                    <group>
                        <field name="titre"/>
                        <field name="source"/>
                        <field name="temperature"/>
                        <field name="reactivation_statut"/>
                    </group>
                    <group>
                        <field name="automation_id"/>
                        <field name="action_type"/>
                    </group>
                </group>
                <div class="alert alert-info mb-2" role="status">
                    <field name="hint_reactivation" nolabel="1" readonly="1"/>
                </div>
                <group string="Message (réponse douce)" invisible="action_type != 'reponse_douce'">
                    <field name="message" nolabel="1"
                           placeholder="Message court et chaleureux…"/>
                </group>
                <div class="alert alert-info" role="status">
                    Réactivation douce : like, commentaire léger ou tâche —
                    <b>sans créer de lead CRM</b>. Vous pourrez qualifier plus tard.
                </div>
                <footer>
                    <button name="action_executer" type="object"
                            string="Exécuter maintenant" class="btn-primary"/>
                    <button name="action_planifier" type="object"
                            string="Planifier" class="btn-secondary"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
