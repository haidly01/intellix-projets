<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_refroidir_signaux" model="ir.cron">
        <field name="name">Doorway — Refroidir signaux veille</field>
        <field name="model_id" ref="model_doorway_veille_signal"/>
        <field name="state">code</field>
        <field name="code">model.cron_refroidir_signaux()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_reactivation_douce" model="ir.cron">
        <field name="name">Doorway — Réactivation douce automatique</field>
        <field name="model_id" ref="model_doorway_veille_signal"/>
        <field name="state">code</field>
        <field name="code">model.cron_reactivation_douce()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
