    <record id="mail_template_zakaria_suite_rencontre_restaurant" model="mail.template">
        <field name="name">Coins Marocain — Suivi rencontre (restaurant)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="subject">Suite à notre rencontre — {{ object.coins_etablissement or object.partner_name or object.name or 'votre établissement' }} sur Coins Marocain</field>
        <field name="email_from">Zakaria — Coins Marocain &lt;zakaria@agencedoorway.com&gt;</field>
        <field name="email_to">{{ object.email_from }}</field>
        <field name="use_default_to" eval="True"/>
        <field name="auto_delete" eval="False"/>
        <field name="description">Envoi MANUEL depuis la fiche lead CM (bouton Envoyer suivi rencontre). Variante restaurant. Vidéo = URL placeholder à remplacer une fois hébergée — pas de pièce jointe.</field>
        <field name="body_html" type="html">
<div style="margin:0;background:#faf6ee;font-family:Jost,Segoe UI,sans-serif;color:#262220;">
  <div style="max-width:600px;margin:0 auto;background:#fffdf8;border:1px solid #e6ddcc;">
    <div style="background:linear-gradient(135deg,#e6b876,#b5732f);padding:28px 32px;color:#fffdf8;">
      <div style="font-size:11px;letter-spacing:.16em;text-transform:uppercase;">Coins Marocain</div>
      <div style="font-family:'Playfair Display','Cormorant Garamond',Georgia,serif;font-size:28px;margin-top:6px;">Suite à notre rencontre</div>
    </div>
    <div style="padding:28px 32px;">
      <t t-set="cm_prenom" t-value="((object.contact_name or (object.partner_id.name if object.partner_id else '') or '').strip().split() or ['bonjour'])[0]"/>
      <t t-set="cm_etab" t-value="object.coins_etablissement or object.partner_name or object.name or 'votre établissement'"/>
      <p>Bonjour <strong><t t-out="cm_prenom"/></strong>,</p>
      <p>
        Merci pour votre accueil et pour l'échange autour de
        <strong><t t-out="cm_etab"/></strong>.
        Voici un court récapitulatif de ce que Coins Marocain peut mettre en place pour votre restaurant.
      </p>
      <p style="text-align:center;margin:28px 0 8px;">
        <a href="https://coinsmarocain.com/assets/video/PLACEHOLDER-a-remplacer-une-fois-hebergee.html"
           style="background:linear-gradient(135deg,#e6b876,#b5732f);color:#fff;padding:12px 22px;text-decoration:none;border-radius:8px;font-weight:600;display:inline-block;">
          Voir la vidéo de démonstration
        </a>
      </p>
      <p style="text-align:center;font-size:12px;color:#8a4f22;margin:0 0 24px;">
        À REMPLACER une fois la vidéo hébergée — lien cliquable uniquement, pas de pièce jointe.
