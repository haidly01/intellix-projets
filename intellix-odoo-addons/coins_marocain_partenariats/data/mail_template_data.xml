<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_coins_entente" model="ir.sequence">
        <field name="name">Entente Coins Marocain</field>
        <field name="code">coins.entente</field>
        <field name="prefix">ENT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="mail_template_coins_entente_lien" model="mail.template">
        <field name="name">Coins — Lien d'activation partenariat</field>
        <field name="model_id" ref="model_coins_entente"/>
        <field name="subject">Votre lien partenaire — {{ object.etablissement or 'Coins Marocain' }}</field>
        <field name="body_html" type="html">
<div style="font-family:sans-serif;font-size:14px;color:#262220;max-width:600px;">
  <p>Bonjour <strong><t t-out="object.partenaire_nom or (object.influenceur_id and object.influenceur_id.name) or 'partenaire'"/></strong>,</p>
  <p>
    Voici votre lien d'activation pour
    <strong><t t-out="object.etablissement or 'Coins Marocain'"/></strong> :
  </p>
  <p style="margin:20px 0;">
    <a t-att-href="object.lien_activation"
       style="background:#b5732f;color:#fff;padding:12px 22px;text-decoration:none;border-radius:4px;font-weight:600;">
      Ouvrir mon lien
    </a>
  </p>
  <p>
    Lien : <a t-att-href="object.lien_activation"><t t-out="object.lien_activation or ''"/></a>
  </p>
  <p>
    Code promo : <strong><t t-out="object.code_promo or ''"/></strong>
  </p>
  <p>À bientôt,<br/>Coins Marocain</p>
</div>
        </field>
    </record>

    <record id="mail_template_zakaria_channel_manager" model="mail.template">
        <field name="name">Zakaria — Prospection hôtels (vidéo Channel Manager)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="subject">Coins Marocain — Channel Manager, fiche et shooting pour {{ object.coins_etablissement or object.partner_name or object.name }}</field>
        <field name="email_from">Zakaria — Coins Marocain &lt;zakaria@agencedoorway.com&gt;</field>
        <field name="email_to">{{ object.email_from }}</field>
        <field name="use_default_to" eval="True"/>
        <field name="description">Prospection hôtel/riad AVANT l'entente : vidéo + explication Channel Manager. Signature Zakaria.</field>
        <field name="body_html" type="html">
<div style="font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:22px;color:#262220;max-width:600px;">
  <p>Bonjour <strong><t t-out="object.contact_name or (object.partner_id and object.partner_id.name) or 'Madame, Monsieur'"/></strong>,</p>
  <p>
    Merci de m'avoir reçu chez
    <strong><t t-out="object.coins_etablissement or object.partner_name or object.name or 'votre établissement'"/></strong>.
    Voici en quelques points ce que Coins Marocain met en place pour les hôtels, riads et villas — avant toute entente.
  </p>
  <h2 style="font-family:Georgia, serif;font-size:18px;color:#3a2418;">Une minute pour voir l'offre hôtels, riads et villas</h2>
  <p>Cette courte vidéo résume ce que Coins Marocain met en place pour votre établissement — fiche, Channel Manager, shooting.</p>
  <p>
    <a href="https://coinsmarocain.com/assets/video/prospection-hotels-riads.html" style="display:block;text-decoration:none;">
      <img src="https://coinsmarocain.com/assets/video/prospection-hotels-riads.jpg" alt="Vidéo Coins Marocain — hôtels, riads et villas" width="528" style="display:block;width:100%;max-width:528px;height:auto;border-radius:4px;"/>
    </a>
  </p>
  <p style="text-align:center;margin:16px 0 24px;">
    <a href="https://coinsmarocain.com/assets/video/prospection-hotels-riads.html"
       style="background:#b5732f;color:#fff;padding:12px 22px;text-decoration:none;border-radius:4px;font-weight:600;display:inline-block;">
      Regarder la vidéo (50 s)
    </a>
  </p>
  <h2 style="font-family:Georgia, serif;font-size:18px;color:#3a2418;">Ce que Coins Marocain vous propose</h2>
  <p>Coins Marocain met votre établissement en avant sur une plateforme dédiée aux voyageurs qui cherchent des adresses authentiques à Marrakech — avec une courte vidéo de présentation plutôt que de simples photos, et une carte interactive.</p>
  <ul>
    <li><strong>Le Channel Manager est gratuit.</strong> Ailleurs, c'est généralement un abonnement payant. Chez nous, il est inclus sans frais.</li>
    <li><strong>Le shooting photo/vidéo est gratuit</strong> pour les hôtels et auberges (2000 dh pour les autres catégories).</li>
  </ul>
  <h2 style="font-family:Georgia, serif;font-size:18px;color:#3a2418;">Qu'est-ce qu'un Channel Manager, concrètement ?</h2>
  <p>C'est l'outil qui <strong>relie en un seul système central</strong> votre compte Booking.com, votre compte Airbnb (si vous les utilisez) et votre fiche Coins Marocain.</p>
  <ol>
    <li><strong>Disponibilités et tarifs à jour partout</strong>, automatiquement.</li>
    <li><strong>Aucun risque de double réservation.</strong></li>
    <li><strong>Les réservations arrivent directement chez vous</strong>, avec les coordonnées du voyageur.</li>
  </ol>
  <h2 style="font-family:Georgia, serif;font-size:18px;color:#3a2418;">Connexion Booking.com et Airbnb</h2>
  <p><strong>On ne vous demande jamais votre mot de passe.</strong> Autorisation officielle uniquement — vous gardez le contrôle de vos comptes.</p>
  <ul>
    <li><strong>Booking.com</strong> : autorisation depuis l'extranet (section connectivité / Channel Manager tiers).</li>
    <li><strong>Airbnb</strong> : lien d'autorisation officiel, comme « se connecter avec Google ».</li>
    <li>Synchronisation généralement sous 24 heures.</li>
  </ul>
  <h2 style="font-family:Georgia, serif;font-size:18px;color:#3a2418;">Commission</h2>
  <ul>
    <li>Réservation via une plateforme connectée : <strong>10 % en plus</strong> de la commission déjà facturée par Booking/Airbnb.</li>
    <li>Réservation directe via Coins Marocain : <strong>15 %</strong>.</li>
  </ul>
  <p>Aucun abonnement, aucun frais fixe. Aucun frais un mois sans réservation via la plateforme.</p>
  <h2 style="font-family:Georgia, serif;font-size:18px;color:#3a2418;">Ensuite, si cela vous convient</h2>
  <ol>
    <li>Vous me dites si vous voulez avancer.</li>
    <li>Je vous envoie alors l'entente à valider (signature électronique, code OTP).</li>
    <li>Shooting photo/vidéo gratuit, mise en ligne de la fiche, connexion du Channel Manager.</li>
  </ol>
  <p>Aucun engagement de durée minimale — vous pourrez résilier à tout moment, les modalités seront dans l'entente.</p>
  <p>Si vous avez des questions, écrivez-moi ou appelez-moi — je reste disponible.</p>
  <p>Au plaisir de vous compter parmi nos partenaires,</p>
  <p>
    <strong>Zakaria</strong><br/>
    Coins Marocain — Digital Doorway SARL<br/>
    <a href="tel:+212660159177" style="color:#b5732f;">+212 660 159 177</a>
    ·
    <a href="mailto:zakaria@coinsmarocain.com" style="color:#b5732f;">zakaria@coinsmarocain.com</a>
  </p>
</div>
        </field>
    </record>

    <record id="mail_template_hebergement_acces" model="mail.template">
        <field name="name">Coins — Accès partenaire hébergement (après signature)</field>
        <field name="model_id" ref="model_coins_entente"/>
        <field name="subject">Bienvenue — vos accès Coins Marocain ({{ object.etablissement or object.name }})</field>
