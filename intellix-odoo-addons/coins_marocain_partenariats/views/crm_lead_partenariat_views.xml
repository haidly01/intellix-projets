<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_coins_partenariat" model="ir.ui.view">
        <field name="name">crm.lead.form.coins.partenariat</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="coins_is_partner_lead" invisible="1"/>
                <field name="coins_is_event_lead" invisible="1"/>
                <field name="coins_show_partner_assign" invisible="1"/>
                <button name="action_coins_relance_faite"
                        type="object"
                        string="Relance faite"
                        class="btn-secondary"
                        invisible="not coins_is_partner_lead"/>
                <button name="action_send_coins_hotel_email"
                        type="object"
                        string="Email prospection"
                        class="btn-primary"
                        invisible="not coins_is_partner_lead"
                        title="Avant la visite — Zakaria peut modifier le brouillon"/>
                <button name="action_send_coins_followup_email"
                        type="object"
                        string="Envoyer suivi rencontre"
                        class="btn-primary"
                        invisible="not coins_is_partner_lead"
                        title="Après la visite — brouillon éditable, envoi manuel uniquement"/>
                <button name="action_coins_envoyer_fiche"
                        type="object"
                        string="Envoyer la fiche"
                        class="btn-primary o_coins_btn_envoyer_fiche"
                        invisible="not coins_is_partner_lead"
                        title="Aperçu du courriel et de la maquette — test doorwaydigital1 d'abord"/>
                <button name="action_coins_creer_entente"
                        type="object"
                        string="Créer / ouvrir l'entente"
                        class="btn-primary"
                        invisible="not coins_is_partner_lead"/>
                <button name="action_coins_envoyer_lien_whatsapp"
                        type="object"
                        string="Envoyer par WhatsApp"
                        class="btn-secondary"
                        invisible="not coins_is_partner_lead"
                        title="Ouvre WhatsApp avec le lien /partenaire/[token]"/>
                <button name="action_coins_envoyer_lien_email"
                        type="object"
                        string="Envoyer par email"
                        class="btn-secondary"
                        invisible="not coins_is_partner_lead"
                        title="Envoie le lien tokenisé à l'email de la fiche"/>
            </xpath>
            <!-- Premier onglet : team_id not in (…) est cassé en OWL (many2one ≠ int). -->
            <xpath expr="//notebook/page[1]" position="before">
                <!-- Assignation unique : CM (flag) + tout lead Réno / Immobilier / Leads Gestion. -->
                <page string="Assignation partenaire" name="assigne_partenaire"
                      invisible="not coins_show_partner_assign">
                    <group>
                        <group>
                            <field name="assignee_kind" widget="radio" options="{'horizontal': true}"/>
                            <field name="coins_commercial_assigne"
                                   invisible="assignee_kind != 'humain'"
                                   options="{'no_create': True}"/>
                            <field name="coins_agent_ia_id"
                                   invisible="assignee_kind != 'ia'"
                                   options="{'no_create': True}"
                                   domain="[('external_agent_id', 'not ilike', 'draft-')]"/>
                            <field name="coins_assignee_display" invisible="1"/>
                            <field name="canal_traitement"/>
                        </group>
                    </group>
                </page>
                <page string="Partenariat" name="coins_partenariat" invisible="not coins_is_partner_lead">
                    <group>
                        <group string="Contact">
                            <field name="contact_name" string="Nom du contact"/>
                            <field name="phone" string="Téléphone"/>
                            <field name="email_from" string="Email"/>
                            <field name="coins_ville" string="Ville / région"/>
                            <field name="coins_ville_autre" invisible="coins_ville != 'autre'"/>
                            <field name="coins_quartier"/>
                            <field name="coins_contact_role"/>
                            <field name="coins_whatsapp"/>
                            <field name="coins_instagram"/>
                            <field name="coins_site_web"/>
                        </group>
                        <group string="Établissement">
                            <field name="coins_fiche_type"/>
                            <field name="coins_etablissement"/>
                            <field name="coins_categorie_etab"/>
                            <field name="coins_type_partenaire"/>
                            <field name="coins_tarif"/>
                            <field name="coins_property_id"/>
                            <field name="coins_partner_lien" widget="url"/>
                            <field name="coins_onboarding_status"/>
                            <field name="coins_entente_id"/>
                            <field name="coins_entente_statut"/>
                            <field name="coins_sale_order_id"/>
                        </group>
                    </group>
                    <group string="Commission">
                        <group>
                            <field name="coins_commission_pct"/>
                            <field name="coins_commission_suggeree"/>
                            <field name="coins_commission_modele"/>
                        </group>
                    </group>
                    <group string="Intérêt services Doorway">
                        <group>
                            <field name="coins_xsell_site_web"/>
                            <field name="coins_interet_shooting" string="Shooting photo/vidéo"/>
                            <field name="coins_xsell_reseaux"/>
                            <field name="coins_shoot_pack"/>
                            <field name="coins_interet_carte"/>
                            <field name="coins_interet_channel_manager"/>
                        </group>
                    </group>
                    <group string="Tâches de suivi">
                        <field name="activity_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="summary" string="Titre"/>
                                <field name="date_deadline" string="Échéance"/>
                                <field name="user_id" string="Assigné à"/>
                                <field name="activity_type_id" optional="show"/>
                            </list>
                        </field>
                    </group>
                    <group string="Note">
                        <field name="coins_note" nolabel="1" colspan="2" placeholder="Contexte informel…"/>
                    </group>
                    <group string="Qualification (appels)">
                        <group>
                            <field name="coins_appel_compose"/>
                            <field name="coins_date_appel"/>
                            <field name="coins_conversation_completee"/>
                            <field name="coins_date_conversation"/>
                            <field name="coins_interet_confirme"/>
                        </group>
                    </group>
                    <group string="Visite">
                        <field name="coins_date_visite"/>
                        <field name="coins_date_visite_realisee"/>
                        <field name="coins_visite_realisee"/>
                        <field name="coins_notes_visite" colspan="2"/>
                    </group>
                </page>
                <page string="Relances" name="coins_relances" invisible="not coins_is_partner_lead">
                    <group>
                        <group>
                            <field name="coins_date_derniere_relance"/>
                            <field name="coins_date_prochaine_relance"/>
                            <field name="coins_relance_canal"/>
                            <field name="coins_nb_relances"/>
                        </group>
                        <group>
                            <field name="date_deadline" string="Échéance CRM"/>
                        </group>
                    </group>
                    <field name="coins_relance_notes" placeholder="Quoi relancer, qui a dit quoi, prochain argument…"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_crm_lead_kanban_coins_partenariat" model="ir.ui.view">
        <field name="name">crm.lead.kanban.coins.partenariat</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority">8</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id"
                    class="o_coins_pipeline_kanban o_coins_pipeline_partenariat o_kanban_small_column"
                    records_draggable="1"
                    groups_draggable="false"
                    group_create="false"
                    group_delete="false"
                    quick_create="true"
                    on_create="quick_create">
                <field name="coins_kanban_title"/>
                <field name="coins_kanban_subtitle"/>
                <field name="coins_kanban_tone"/>
                <field name="coins_kanban_categorie"/>
                <field name="coins_kanban_commission"/>
                <field name="coins_kanban_source"/>
                <field name="coins_kanban_source_kind"/>
                <field name="coins_kanban_commercial"/>
                <field name="stage_id" readonly="0"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="o_coins_lead_card {{ record.coins_kanban_tone.raw_value or '' }}">
                            <div class="o_coins_lead_name">
                                <field name="coins_kanban_title"/>
                            </div>
                            <div class="o_coins_lead_meta">
                                <span class="o_coins_badge o_coins_badge_cat">
                                    <field name="coins_kanban_categorie"/>
                                </span>
                                <span class="o_coins_badge o_coins_badge_comm">
                                    <field name="coins_kanban_commission"/>
                                </span>
                            </div>
                            <div class="o_coins_lead_meta">
                                <span t-attf-class="o_coins_badge o_coins_badge_{{ record.coins_kanban_source_kind.raw_value or 'manual' }}">
                                    <field name="coins_kanban_source"/>
                                </span>
                                <span t-if="record.coins_kanban_commercial.raw_value" class="o_coins_badge o_coins_badge_user">
                                    <field name="coins_kanban_commercial"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_crm_lead_list_coins_partenariat" model="ir.ui.view">
        <field name="name">crm.lead.list.coins.partenariat</field>
        <field name="model">crm.lead</field>
        <field name="priority">8</field>
        <field name="arch" type="xml">
            <list>
                <field name="coins_kanban_title" string="Établissement"/>
                <field name="coins_ville"/>
                <field name="coins_assignee_display" string="Assigné"/>
                <field name="assignee_kind" optional="hide"/>
                <field name="coins_commercial_assigne" optional="hide"/>
                <field name="coins_agent_ia_id" optional="hide"/>
                <field name="canal_traitement"/>
                <field name="coins_categorie_etab"/>
                <field name="coins_onboarding_status"/>
                <field name="coins_commission_pct"/>
                <field name="stage_id"/>
            </list>
        </field>
    </record>

    <!-- Priority 32 : ne pas voler default_view(crm.lead, form) après ITEX. -->
    <record id="view_crm_lead_form_coins_partenariat_fiche" model="ir.ui.view">
        <field name="name">crm.lead.form.coins.partenariat.fiche</field>
        <field name="model">crm.lead</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <form class="o_coins_fiche" string="Fiche établissement">
                <header>
                    <button name="action_send_coins_hotel_email"
                            type="object"
                            string="Email prospection"
                            class="btn-secondary"/>
                    <button name="action_send_coins_followup_email"
                            type="object"
                            string="Envoyer suivi rencontre"
                            class="btn-secondary"/>
                    <button name="action_coins_envoyer_fiche"
                            type="object"
                            string="Envoyer la fiche"
                            class="btn-primary o_coins_btn_envoyer_fiche"
                            title="Aperçu du courriel et de la maquette — test doorwaydigital1 d'abord"/>
                    <button name="action_coins_creer_entente"
                            type="object"
                            string="Créer / ouvrir l'entente"
                            class="btn-primary"/>
                    <button name="action_coins_envoyer_lien_whatsapp"
                            type="object"
                            string="Envoyer par WhatsApp"
                            class="btn-secondary"
                            title="Ouvre WhatsApp avec le lien /partenaire/[token]"/>
                    <button name="action_coins_envoyer_lien_email"
                            type="object"
                            string="Envoyer par email"
                            class="btn-secondary"
                            title="Envoie le lien tokenisé à l'email de la fiche"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet class="o_coins_fiche_sheet">
                    <field name="team_id" invisible="1"/>
                    <field name="type" invisible="1"/>
                    <field name="coins_fiche_type" invisible="1"/>
                    <div class="o_coins_pipeline_banner">Pipeline partenariats — fiche établissement</div>
                    <div class="o_coins_fiche_head">
                        <div class="o_coins_avatar"><field name="coins_fiche_initials" nolabel="1"/></div>
                        <div>
                            <div class="o_coins_fiche_title">
                                <field name="coins_etablissement" placeholder="Nom de l'établissement"/>
                            </div>
                            <div class="o_coins_fiche_sub">Fiche établissement</div>
                        </div>
                    </div>
                    <div class="o_coins_section_label">Contact</div>
                    <group>
                        <group>
                            <field name="contact_name" string="Nom du contact"/>
                            <field name="phone" string="Téléphone"/>
                            <field name="email_from" string="Email"/>
                            <field name="coins_whatsapp"/>
                        </group>
                        <group>
                            <field name="coins_ville" string="Ville / région"/>
                            <field name="coins_ville_autre" invisible="coins_ville != 'autre'"/>
                            <field name="coins_quartier"/>
                            <field name="coins_contact_role"/>
                        </group>
                    </group>
                    <div class="o_coins_section_label">Établissement</div>
                    <group>
                        <group>
                            <field name="coins_categorie_etab" string="Catégorie"/>
                            <field name="coins_type_partenaire"/>
                            <field name="assignee_kind" widget="radio" options="{'horizontal': true}"/>
                            <field name="coins_commercial_assigne"
                                   invisible="assignee_kind != 'humain'"
                                   options="{'no_create': True}"/>
                            <field name="coins_agent_ia_id"
                                   invisible="assignee_kind != 'ia'"
                                   options="{'no_create': True}"
                                   domain="[('external_agent_id', 'not ilike', 'draft-')]"/>
                            <field name="canal_traitement"/>
                            <field name="coins_tarif" string="Tarif"/>
                        </group>
                        <group>
                            <field name="coins_commission_pct" string="Commission"/>
                            <field name="coins_commission_modele"/>
                            <field name="coins_property_id"/>
                            <field name="coins_partner_lien" widget="url"/>
                            <field name="coins_onboarding_status"/>
                            <field name="coins_entente_id"/>
                            <field name="coins_entente_statut" string="Statut entente"/>
                            <field name="coins_sale_order_id"/>
                            <field name="name" string="Intitulé interne"/>
                        </group>
                    </group>
                    <div class="o_coins_section_label">Intérêt services Doorway</div>
                    <group class="o_coins_chips">
                        <field name="coins_xsell_site_web"/>
                        <field name="coins_interet_shooting" string="Shooting photo/vidéo"/>
                        <field name="coins_xsell_reseaux"/>
                        <field name="coins_shoot_pack"/>
                    </group>
                    <div class="o_coins_section_label">Tâches de suivi</div>
                    <field name="activity_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="summary" string="Titre"/>
                            <field name="date_deadline" string="Échéance"/>
                            <field name="user_id" string="Assigné à"/>
                        </list>
                    </field>
                    <div class="o_coins_section_label">Qualification / visite</div>
                    <group>
                        <group>
                            <field name="coins_appel_compose"/>
                            <field name="coins_date_appel"/>
                            <field name="coins_conversation_completee"/>
                            <field name="coins_date_conversation"/>
                            <field name="coins_interet_confirme"/>
                        </group>
                        <group>
                            <field name="coins_date_visite"/>
                            <field name="coins_date_visite_realisee"/>
                        </group>
                    </group>
                    <div class="o_coins_section_label">Note</div>
                    <field name="coins_note" nolabel="1" placeholder="Contexte informel…"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
