<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coins_entente_activation_list" model="ir.ui.view">
        <field name="name">coins.entente.activation.list</field>
        <field name="model">coins.entente.activation</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="entente_id"/>
                <field name="montant"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_coins_entente_activation_form" model="ir.ui.view">
        <field name="name">coins.entente.activation.form</field>
        <field name="model">coins.entente.activation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="entente_id"/>
                        <field name="date"/>
                        <field name="montant"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_coins_entente_activation" model="ir.actions.act_window">
        <field name="name">Activations</field>
        <field name="res_model">coins.entente.activation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
