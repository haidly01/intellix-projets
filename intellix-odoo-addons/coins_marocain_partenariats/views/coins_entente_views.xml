<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coins_entente_list" model="ir.ui.view">
        <field name="name">coins.entente.list</field>
        <field name="model">coins.entente</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type_partenaire"/>
                <field name="influenceur_id" optional="show"/>
                <field name="partenaire_nom"/>
                <field name="etablissement"/>
                <field name="statut_entente" widget="badge"/>
                <field name="date_signature" optional="hide"/>
                <field name="date_debut"/>
                <field name="date_renouvellement"/>
                <field name="code_promo"/>
                <field name="nombre_activations"/>
                <field name="montant_ventes_generees"/>
                <field name="commission_calculee"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_coins_entente_kanban" model="ir.ui.view">
        <field name="name">coins.entente.kanban</field>
        <field name="model">coins.entente</field>
        <field name="arch" type="xml">
            <kanban default_group_by="statut_entente" class="o_kanban_small_column">
                <field name="name"/>
                <field name="type_partenaire"/>
                <field name="partenaire_nom"/>
                <field name="influenceur_id"/>
                <field name="etablissement"/>
                <field name="date_renouvellement"/>
                <field name="commission_calculee"/>
                <field name="currency_id"/>
                <field name="statut_entente"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div t-if="record.partenaire_nom.raw_value or record.influenceur_id.raw_value">
                                <field name="partenaire_nom"/>
                                <field name="influenceur_id"/>
                            </div>
                            <div><field name="type_partenaire"/></div>
                            <div t-if="record.etablissement.raw_value">
                                <field name="etablissement"/>
                            </div>
                            <div t-if="record.date_renouvellement.raw_value">
                                Renouv. <field name="date_renouvellement"/>
                            </div>
                            <div>
                                Commission
                                <field name="commission_calculee"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_coins_entente_form" model="ir.ui.view">
        <field name="name">coins.entente.form</field>
        <field name="model">coins.entente</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_envoyer_lien" type="object"
                            string="Envoyer le lien"
                            class="btn-primary"
                            invisible="not lien_activation"/>
                    <button name="action_generer_lien" type="object"
                            string="Générer le lien"
                            invisible="lien_activation"/>
                    <button name="action_enregistrer_activation" type="object"
                            string="Enregistrer une activation"
                            class="btn-secondary"/>
                    <button name="action_envoyer_signature" type="object"
                            string="Envoyer la signature"
                            class="btn-primary"
                            invisible="type_partenaire != 'hebergement' or date_signature"/>
                    <field name="statut_entente" widget="statusbar"
                           statusbar_visible="en_attente_signature,active,a_renouveler,terminee"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_activations" type="object"
                                class="oe_stat_button" icon="fa-line-chart">
                            <field name="activation_count" widget="statinfo" string="Activations"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Partenaire">
                            <field name="type_partenaire"/>
                            <field name="influenceur_id"
                                   invisible="type_partenaire != 'influenceur'"/>
                            <field name="partenaire_nom"/>
                            <field name="contact_partenaire"
                                   placeholder="email@… ou +212…"/>
                            <field name="partner_id"
                                   invisible="type_partenaire != 'hebergement'"/>
                            <field name="etablissement"/>
                            <field name="shooting_souhaite"
                                   invisible="type_partenaire != 'hebergement'"/>
                        </group>
                        <group string="Cycle">
                            <field name="duree_cycle"/>
                            <field name="date_debut"/>
                            <field name="date_renouvellement"
                                   readonly="duree_cycle != 'autre'"/>
                            <field name="type_remuneration"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Rémunération &amp; tracking">
                            <field name="pourcentage_commission"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="part_doorway"/>
                            <field name="code_promo"/>
                            <field name="lien_activation" widget="url"/>
                            <field name="date_envoi_lien"/>
                            <field name="date_activation"/>
                        </group>
                        <group string="Résultats du cycle">
                            <field name="nombre_activations"/>
                            <field name="montant_ventes_generees"/>
                            <field name="commission_calculee"
                                   class="oe_subtotal_footer_separator"/>
                            <field name="part_influenceur_calculee"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Clauses" name="clauses"
                              invisible="type_partenaire != 'hebergement'">
                            <group>
                                <group string="Signature">
                                    <field name="signature_id"/>
                                    <field name="date_envoi_signature"/>
                                    <field name="date_signature"/>
                                    <field name="pdf_signe" filename="pdf_signe_filename"/>
                                    <field name="pdf_signe_filename" invisible="1"/>
                                </group>
                            </group>
                            <field name="clauses_html" nolabel="1"/>
                        </page>
                        <page string="Activations" name="activations">
                            <field name="activation_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="montant"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_coins_entente_search" model="ir.ui.view">
        <field name="name">coins.entente.search</field>
        <field name="model">coins.entente</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partenaire_nom"/>
                <field name="code_promo"/>
                <field name="etablissement"/>
                <filter name="filter_signature" string="En attente de signature"
                        domain="[('statut_entente', '=', 'en_attente_signature')]"/>
                <filter name="filter_active" string="Actives"
                        domain="[('statut_entente', '=', 'active')]"/>
                <filter name="filter_renouveler" string="À renouveler"
                        domain="[('statut_entente', '=', 'a_renouveler')]"/>
                <group>
                    <filter name="group_statut" string="Statut"
                            context="{'group_by': 'statut_entente'}"/>
                    <filter name="group_type" string="Type partenaire"
                            context="{'group_by': 'type_partenaire'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_coins_entente" model="ir.actions.act_window">
        <field name="name">Ententes</field>
        <field name="res_model">coins.entente</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_coins_entente_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première entente
            </p>
            <p>Influenceurs, hôtels / riads / villas, wedding planners, agences de voyage, congrès.</p>
        </field>
    </record>
</odoo>
