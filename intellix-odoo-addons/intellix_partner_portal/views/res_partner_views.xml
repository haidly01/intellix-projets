<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_portal_fields" model="ir.ui.view">
        <field name="name">res.partner.form.intellix.portal</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="renovation_conciergerie.res_partner_view_form_renovation"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='coverage_mode']" position="after">
                <field name="monthly_lead_capacity"/>
                <field name="leads_used_this_month" readonly="1"/>
                <field name="partner_pause_mode"/>
                <field name="partner_score"/>
                <field name="active_bloc_id" readonly="1"/>
            </xpath>
            <xpath expr="//page[@name='renovation_tab']" position="after">
                <page string="Mandats portail" name="ipp_mandates_tab" groups="base.group_user">
                    <field name="mandate_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="status"/>
                            <field name="ia_score"/>
                            <field name="city"/>
                            <field name="assigned_user_id"/>
                        </list>
                    </field>
                </page>
                <page string="Blocs leads" name="ipp_blocs_tab" groups="base.group_user">
                    <field name="bloc_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="size"/>
                            <field name="delivered_count"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
