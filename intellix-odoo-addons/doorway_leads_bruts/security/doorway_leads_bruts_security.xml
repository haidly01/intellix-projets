<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_leads_bruts" model="ir.module.category">
        <field name="name">Extracteur</field>
        <field name="sequence">45</field>
    </record>

    <record id="res_groups_privilege_leads_bruts" model="res.groups.privilege">
        <field name="name">Extracteur</field>
        <field name="sequence">45</field>
        <field name="category_id" ref="module_category_leads_bruts"/>
    </record>

    <record id="group_leads_bruts_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_leads_bruts"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_leads_bruts_manager" model="res.groups">
        <field name="name">Gestionnaire</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_leads_bruts"/>
        <field name="implied_ids" eval="[(4, ref('group_leads_bruts_user'))]"/>
    </record>

    <record id="group_admin_commercial" model="res.groups">
        <field name="name">Admin commercial</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_leads_bruts"/>
        <field name="implied_ids" eval="[(4, ref('group_leads_bruts_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
