<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Sources du Configurateur de Campagnes (INTLX-EXT).
        Portage de SOURCES_DB (brief). Une source peut apparaître dans
        plusieurs secteurs : on crée un enregistrement par couple
        (source, secteur) avec un `code` unique et un `ext_source_id`
        métier (réutilisé tel quel par Claude / l'auto-sélection).
    -->

    <!-- ================= FRANCE — ASSURANCE ================= -->
    <record id="ext_src_pages_jaunes_fr_assurance" model="doorway.source.registry">
        <field name="name">Pages Jaunes France</field>
        <field name="code">ext_pages_jaunes_fr_assurance</field>
        <field name="ext_source_id">pages_jaunes_fr</field>
        <field name="pays">france</field>
        <field name="secteur">assurance</field>
        <field name="type_source">annuaire</field>
        <field name="description">Particuliers et professionnels avec coordonnées</field>
        <field name="types_leads">particuliers,artisans,TPE</field>
        <field name="filtres_dispo">departement,ville,code_postal</field>
        <field name="cout_estime">INTLX-EXT-BRUT</field>
        <field name="qualite">3</field>
        <field name="rating_stars">3</field>
        <field name="url_pattern">https://www.pagesjaunes.fr/pagesblanches/recherche?quoi={secteur}&amp;ou={zone}</field>
    </record>
