<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ix_category_video_list" model="ir.ui.view">
        <field name="name">ix.category.video.list</field>
        <field name="model">ix.category.video</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="category"/>
                <field name="video_url"/>
                <field name="updated_at"/>
            </list>
        </field>
    </record>
    <record id="action_ix_category_videos" model="ir.actions.act_window">
        <field name="name">Vidéos devis (secteur)</field>
        <field name="res_model">ix.category.video</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
