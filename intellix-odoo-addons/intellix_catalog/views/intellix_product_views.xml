<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_intellix_prices" model="ir.ui.view">
        <field name="name">product.template.form.intellix.prices</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="ix_billing_type"/>
                <field name="ix_price_mad"/>
                <field name="ix_price_cad"/>
                <field name="ix_quote_only"/>
            </xpath>
        </field>
    </record>
</odoo>
