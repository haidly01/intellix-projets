        <field name="product_id" model="product.product" search="[('default_code', '=', 'AGENT_IA_ABO')]"/>
        <field name="product_uom_qty">1</field>
    </record>
    <record id="quotation_line_croissance_conception" model="sale.order.template.line">
        <field name="sale_order_template_id" ref="quotation_template_croissance_ia"/>
        <field name="sequence">30</field>
        <field name="product_id" model="product.product" search="[('default_code', '=', 'AGENT_IA_CONCEPTION_NEUF')]"/>
        <field name="product_uom_qty">1</field>
    </record>
    <record id="quotation_line_croissance_bundle" model="sale.order.template.line">
        <field name="sale_order_template_id" ref="quotation_template_croissance_ia"/>
        <field name="sequence">40</field>
        <field name="product_id" model="product.product" search="[('default_code', '=', 'AGENT_IA_BUNDLE_M')]"/>
        <field name="product_uom_qty">1</field>
    </record>

    <record id="quotation_template_presence_digitale" model="sale.order.template">
        <field name="name">Présence Digitale Complète</field>
        <field name="ix_template_code">presence_digitale</field>
        <field name="ix_tax_mode">with_tax</field>
        <field name="sequence">30</field>
        <field name="number_of_days">15</field>
        <field name="company_id" eval="False"/>
        <field name="note" type="html">
            <p>Pack complet. Ajuster conception (neuf/reprise), bundle S/M/L, site Simple/Standard/Premium et SEO Essentiel/Croissance/Intensif avant envoi.</p>
