<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doorway_videoconf_wizard_form" model="ir.ui.view">
        <field name="name">doorway.videoconf.wizard.form</field>
        <field name="model">doorway.videoconf.wizard</field>
        <field name="arch" type="xml">
            <form string="Vidéoconférence">
                <group>
                    <field name="meeting_type" widget="radio"/>
                    <field name="name"/>
                    <field name="partner_ids" widget="many2many_tags"
                           placeholder="Inviter des participants (e-mail requis)"/>
                </group>
                <group invisible="meeting_type != 'scheduled'">
                    <field name="start" required="meeting_type == 'scheduled'"/>
                    <field name="duration_minutes"/>
                </group>
                <group invisible="meeting_type != 'instant'">
                    <field name="duration_minutes" string="Durée prévue (min)"/>
                </group>
                <footer>
                    <button name="action_create" type="object"
                            string="Créer et rejoindre" class="btn-primary"
                            invisible="meeting_type != 'instant'"/>
                    <button name="action_create" type="object"
                            string="Planifier la visio" class="btn-primary"
                            invisible="meeting_type != 'scheduled'"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_doorway_videoconf_wizard" model="ir.actions.act_window">
        <field name="name">Vidéoconférence</field>
        <field name="res_model">doorway.videoconf.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_doorway_instant_videocall" model="ir.actions.server">
        <field name="name">Réunion instantanée</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="state">code</field>
        <field name="code">action = model.action_doorway_instant_videocall()</field>
    </record>

    <record id="action_doorway_schedule_videoconf" model="ir.actions.act_window">
        <field name="name">Planifier une visio</field>
        <field name="res_model">doorway.videoconf.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_meeting_type': 'scheduled'}</field>
    </record>
</odoo>
