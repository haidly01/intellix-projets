<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doorway_call_report_list" model="ir.ui.view">
        <field name="name">doorway.call.report.list</field>
        <field name="model">doorway.call.report</field>
        <field name="arch" type="xml">
            <list string="Rapports post-appel" default_order="create_date desc">
                <field name="name"/>
                <field name="agent_id"/>
                <field name="lead_id"/>
                <field name="score_global"/>
                <field name="quality_band"/>
                <field name="prochaine_action"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_doorway_call_report_form" model="ir.ui.view">
        <field name="name">doorway.call.report.form</field>
        <field name="model">doorway.call.report</field>
        <field name="arch" type="xml">
            <form string="Rapport post-appel">
                <sheet>
                    <group>
                        <field name="session_id"/>
                        <field name="agent_id"/>
                        <field name="lead_id"/>
                        <field name="quality_band"/>
                        <field name="prochaine_action"/>
                    </group>
                    <group string="Scores (0-10)">
                        <field name="score_accroche"/>
                        <field name="score_qualification"/>
                        <field name="score_objections"/>
                        <field name="score_closing"/>
                        <field name="score_global"/>
                    </group>
                    <group>
                        <field name="points_forts"/>
                        <field name="points_amelioration"/>
                    </group>
                    <group string="Résumé Claude">
                        <field name="claude_summary" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_doorway_call_report_kanban" model="ir.ui.view">
        <field name="name">doorway.call.report.kanban</field>
        <field name="model">doorway.call.report</field>
        <field name="arch" type="xml">
            <kanban default_group_by="quality_band" class="o_kanban_small_column">
                <field name="name"/>
                <field name="agent_id"/>
                <field name="score_global"/>
                <field name="quality_band"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div><field name="agent_id"/></div>
                            <div>Score : <field name="score_global"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_doorway_call_report_search" model="ir.ui.view">
        <field name="name">doorway.call.report.search</field>
        <field name="model">doorway.call.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="agent_id"/>
                <field name="lead_id"/>
                <filter name="today" string="Aujourd'hui"
                    domain="[('create_date','&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="excellent" string="Excellent" domain="[('quality_band','=','excellent')]"/>
                <filter name="good" string="Bon" domain="[('quality_band','=','good')]"/>
                <filter name="improve" string="À améliorer" domain="[('quality_band','=','improve')]"/>
                <group>
                    <filter name="group_agent" string="Agent" context="{'group_by': 'agent_id'}"/>
                    <filter name="group_band" string="Qualité" context="{'group_by': 'quality_band'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_doorway_call_report" model="ir.actions.act_window">
        <field name="name">Rapports post-appel</field>
        <field name="res_model">doorway.call.report</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>
</odoo>
