# Clés API — Agents Dashboard (Doorway)
# Copier vers /etc/odoo-server.conf [options] ou variables d'environnement systemd
# Générer webhook: openssl rand -hex 32

ELEVENLABS_API_KEY=sk_...         # console.elevenlabs.io > API Keys
TWILIO_ACCOUNT_SID=AC...          # console.twilio.com
TWILIO_AUTH_TOKEN=...             # console.twilio.com
TWILIO_FROM_NUMBER=+15141234567   # Numéro Twilio source appels test
N8N_BASE_URL=https://n8n.example.com
N8N_API_TOKEN=...
N8N_AGENT_SYNC_PATH=/webhook/doorway/agents/sync
N8N_START_CALL_PATH=/webhook/doorway/agents/start-call
N8N_START_WEB_TEST_PATH=/webhook/doorway/agents/start-web-test
N8N_GET_CALL_PATH=/webhook/doorway/agents/get-call
ANTHROPIC_API_KEY=sk-ant-...      # console.anthropic.com
DOORWAY_AGENTS_WEBHOOK_KEY=...    # openssl rand -hex 32

# Google Sheets — export appels (optionnel, sans pipeline)
# Paramètres Odoo : doorway_agents_dashboard.google_sheets_enabled = True
# GOOGLE_SHEETS_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
# GOOGLE_SHEETS_CREDENTIALS_JSON={"type":"service_account",...}
# Ou webhook Apps Script : doorway_agents_dashboard.google_sheets_webhook_url
