<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_sync_agents_dashboard" model="ir.cron">
        <field name="name">Dashboard Agents — sync ElevenLabs / n8n</field>
        <field name="model_id" ref="model_doorway_agent_profile"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_agents()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_lea_qc_claude_analyze" model="ir.cron">
        <field name="name">Léa-QC — analyse Claude post-appel (A/B)</field>
        <field name="model_id" ref="model_lea_qc_sample_call"/>
        <field name="state">code</field>
        <field name="code">model.cron_analyze_pending_claude(limit=15)</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
