<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_doorway_coaching_realtime" model="ir.cron">
        <field name="name">Doorway Agents — Coaching temps réel</field>
        <field name="model_id" ref="model_doorway_call_session"/>
        <field name="state">code</field>
        <field name="code">model._cron_realtime_coaching()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_doorway_vicidial_sync" model="ir.cron">
        <field name="name">Doorway Agents — Sync VICIdial</field>
        <field name="model_id" ref="model_doorway_call_session"/>
        <field name="state">code</field>
        <field name="code">model.sync_from_vicidial()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
