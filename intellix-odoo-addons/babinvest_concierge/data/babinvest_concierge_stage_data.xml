        <field name="name">Compromis/Dépôt</field>
        <field name="sequence">90</field>
        <field name="is_won">True</field>
        <field name="fold">True</field>
    </record>
    <record id="stage_perdu" model="babinvest.concierge.stage">
        <field name="name">Perdu</field>
        <field name="sequence">100</field>
        <field name="is_lost">True</field>
        <field name="fold">True</field>
    </record>
</odoo>
