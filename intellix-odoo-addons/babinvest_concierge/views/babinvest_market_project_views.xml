<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_babinvest_market_list" model="ir.ui.view">
        <field name="name">babinvest.market.list</field>
        <field name="model">babinvest.market</field>
        <field name="arch" type="xml">
            <list string="Marchés">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>
    <record id="action_babinvest_market" model="ir.actions.act_window">
        <field name="name">Marchés</field>
        <field name="res_model">babinvest.market</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_babinvest_project_list" model="ir.ui.view">
        <field name="name">babinvest.project.list</field>
        <field name="model">babinvest.project</field>
        <field name="arch" type="xml">
            <list string="Projets">
                <field name="name"/>
                <field name="market_id"/>
                <field name="city"/>
                <field name="unit_price_min" widget="monetary"/>
                <field name="unit_price_max" widget="monetary"/>
                <field name="rental_yield_pct"/>
            </list>
        </field>
    </record>
    <record id="view_babinvest_project_form" model="ir.ui.view">
        <field name="name">babinvest.project.form</field>
        <field name="model">babinvest.project</field>
        <field name="arch" type="xml">
            <form string="Projet">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="market_id"/>
                        <field name="city"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="unit_price_min" widget="monetary"/>
                        <field name="unit_price_max" widget="monetary"/>
                        <field name="rental_yield_pct"/>
                    </group>
                    <field name="description" placeholder="Description du projet..."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_babinvest_project" model="ir.actions.act_window">
        <field name="name">Projets</field>
        <field name="res_model">babinvest.project</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
