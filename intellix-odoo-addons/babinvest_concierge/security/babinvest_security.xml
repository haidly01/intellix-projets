<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_babinvest" model="ir.module.category">
        <field name="name">Bab Invest</field>
        <field name="sequence">56</field>
    </record>

    <record id="res_groups_privilege_babinvest" model="res.groups.privilege">
        <field name="name">Bab Invest</field>
        <field name="sequence">56</field>
        <field name="category_id" ref="module_category_babinvest"/>
    </record>

    <record id="group_babinvest_user" model="res.groups">
        <field name="name">Commercial</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_babinvest"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_babinvest_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_babinvest"/>
        <field name="implied_ids" eval="[(4, ref('group_babinvest_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
