<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_doorway_credits_admin" model="res.groups">
        <field name="name">Doorway Crédits — Admin plateforme</field>
        <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>
    <record id="group_doorway_credits_tenant" model="res.groups">
        <field name="name">Doorway Crédits — Client tenant</field>
    </record>

    <!-- Tous les utilisateurs internes voient le tenant de leur société -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_doorway_credits_tenant'))]"/>
    </record>

    <record id="rule_tenant_own_company" model="ir.rule">
        <field name="name">Tenant : sa société uniquement</field>
        <field name="model_id" ref="model_doorway_tenant"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_doorway_credits_tenant'))]"/>
    </record>
    <record id="rule_credit_account_tenant" model="ir.rule">
        <field name="name">Compte crédits : sa société</field>
        <field name="model_id" ref="model_doorway_credit_account"/>
        <field name="domain_force">[('tenant_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_doorway_credits_tenant'))]"/>
    </record>
    <record id="rule_credit_tx_tenant" model="ir.rule">
        <field name="name">Transactions : sa société</field>
        <field name="model_id" ref="model_doorway_credit_transaction"/>
        <field name="domain_force">[('tenant_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_doorway_credits_tenant'))]"/>
    </record>
    <record id="rule_credit_purchase_tenant" model="ir.rule">
        <field name="name">Achats : sa société</field>
        <field name="model_id" ref="model_doorway_credit_purchase"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_doorway_credits_tenant'))]"/>
    </record>
</odoo>
