<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_credits_home" model="ir.actions.server">
        <field name="name">Crédits IA</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">action = env['doorway.onboarding.service'].action_open_home('doorway_credits')</field>
    </record>

    <record id="action_credits_onboarding_tour" model="ir.actions.act_window">
        <field name="name">Visite guidée</field>
        <field name="res_model">doorway.onboarding.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_tour_code': 'doorway_credits'}</field>
    </record>
</odoo>
