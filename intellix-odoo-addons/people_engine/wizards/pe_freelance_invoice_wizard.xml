<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pe_freelance_invoice_wizard_form" model="ir.ui.view">
        <field name="name">pe.freelance.invoice.wizard.form</field>
        <field name="model">pe.freelance.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Générer factures freelance">
                <group>
                    <field name="period_start"/>
                    <field name="period_end"/>
                    <field name="employee_ids" widget="many2many_tags"/>
                    <field name="auto_issue"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Générer"
                            class="btn-primary"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pe_freelance_invoice_wizard" model="ir.actions.act_window">
        <field name="name">Générer factures freelance</field>
        <field name="res_model">pe.freelance.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
