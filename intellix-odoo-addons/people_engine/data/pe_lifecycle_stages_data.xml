<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="lifecycle_stage_candidate" model="pe.employee.lifecycle.stage">
        <field name="name">Candidat</field>
        <field name="code">candidate</field>
        <field name="sequence">10</field>
        <field name="color">4</field>
        <field name="description">Personne en cours de recrutement, avant signature.</field>
    </record>

    <record id="lifecycle_stage_arrival" model="pe.employee.lifecycle.stage">
        <field name="name">Arrivée / Onboarding</field>
        <field name="code">arrival</field>
        <field name="sequence">20</field>
        <field name="color">10</field>
        <field name="is_arrival">True</field>
        <field name="description">Intégration, documents d'arrivée et accueil.</field>
    </record>

    <record id="lifecycle_stage_probation" model="pe.employee.lifecycle.stage">
        <field name="name">Période d'essai</field>
        <field name="code">probation</field>
        <field name="sequence">30</field>
        <field name="color">3</field>
        <field name="description">Collaborateur en période probatoire.</field>
    </record>

    <record id="lifecycle_stage_active" model="pe.employee.lifecycle.stage">
        <field name="name">Actif</field>
        <field name="code">active</field>
        <field name="sequence">40</field>
        <field name="color">7</field>
        <field name="description">Collaborateur confirmé en poste.</field>
    </record>

    <record id="lifecycle_stage_departure" model="pe.employee.lifecycle.stage">
        <field name="name">Départ</field>
        <field name="code">departure</field>
        <field name="sequence">50</field>
        <field name="color">1</field>
        <field name="description">Fin de collaboration, documents de sortie.</field>
    </record>
</odoo>
