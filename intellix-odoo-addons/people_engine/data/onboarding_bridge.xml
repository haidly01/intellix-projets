<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_pe_home" model="ir.actions.server">
        <field name="name">RH</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">action = env['pe.onboarding.service']._action_default_dashboard()</field>
    </record>

    <record id="action_pe_onboarding_wizard" model="ir.actions.act_window">
        <field name="name">Visite guidée</field>
        <field name="res_model">doorway.onboarding.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_tour_code': 'people_engine'}</field>
    </record>
</odoo>
