        <field name="name">RH</field>
        <field name="sequence">12</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_employee" model="res.groups">
        <field name="name">RH — Employé</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_people_engine"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">RH — Gestionnaire</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_people_engine"/>
        <field name="implied_ids" eval="[(4, ref('group_employee'))]"/>
    </record>

    <record id="group_hr" model="res.groups">
        <field name="name">RH — Responsable RH</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_people_engine"/>
        <field name="implied_ids" eval="[(4, ref('group_manager'))]"/>
    </record>

    <record id="group_admin" model="res.groups">
        <field name="name">RH — Administrateur</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_people_engine"/>
        <field name="implied_ids" eval="[(4, ref('group_hr'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Employé : son profil uniquement -->
    <record id="rule_profile_employee" model="ir.rule">
        <field name="name">PE Profil : employé (soi)</field>
        <field name="model_id" ref="model_pe_employee_profile"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_employee'))]"/>
    </record>

    <!-- Gestionnaire : équipe directe -->
    <record id="rule_profile_manager" model="ir.rule">
        <field name="name">PE Profil : gestionnaire (équipe)</field>
        <field name="model_id" ref="model_pe_employee_profile"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_manager'))]"/>
    </record>

