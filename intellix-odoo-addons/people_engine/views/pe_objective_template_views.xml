<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pe_objective_template_tree" model="ir.ui.view">
        <field name="name">pe.objective.template.tree</field>
        <field name="model">pe.objective.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="line_count" string="Lignes"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pe_objective_template_form" model="ir.ui.view">
        <field name="name">pe.objective.template.form</field>
        <field name="model">pe.objective.template</field>
        <field name="arch" type="xml">
            <form string="Modèle d'objectifs">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ex. Gestionnaire commercial"/></h1>
                    </div>
                    <group>
                        <field name="active"/>
                        <field name="description" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Lignes d'objectifs">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="objective_type"/>
                                    <field name="period"/>
                                    <field name="target_value"/>
                                    <field name="unit"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pe_objective_template" model="ir.actions.act_window">
        <field name="name">Modèles d'objectifs</field>
        <field name="res_model">pe.objective.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez un modèle réutilisable d'objectifs KPI.
            </p>
            <p>
                Appliquez-le sur un contrat (objectifs contractuels) ou sur un profil
                (suivi opérationnel). Vous pouvez aussi enregistrer un jeu d'objectifs
                existant via « Enregistrer comme modèle ».
            </p>
        </field>
    </record>
</odoo>
