<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pe_prime_template_tree" model="ir.ui.view">
        <field name="name">pe.prime.template.tree</field>
        <field name="model">pe.prime.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="calculation_type"/>
                <field name="objective_period"/>
                <field name="taux_commission"/>
                <field name="montant_variable"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pe_prime_template_form" model="ir.ui.view">
        <field name="name">pe.prime.template.form</field>
        <field name="model">pe.prime.template</field>
        <field name="arch" type="xml">
            <form string="Modèle de prime variable">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ex. 5% revenus extra mensuel"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="calculation_type"/>
                            <field name="objective_period"/>
                        </group>
                        <group>
                            <field name="montant_variable"/>
                            <field name="taux_commission"/>
                            <field name="prime_performance_base"/>
                            <field name="challenges_eligible"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" colspan="2"/>
                        <field name="description_variable" colspan="2"
                               placeholder="Critères d'attribution, lien avec les objectifs KPI…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pe_prime_template" model="ir.actions.act_window">
        <field name="name">Modèles de prime variable</field>
        <field name="res_model">pe.prime.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez un modèle réutilisable pour la part variable.
            </p>
            <p>
                Les modèles relient la rémunération variable aux objectifs KPI et aux primes
                de performance. Appliquez-les sur le profil employé ou le contrat, ou
                personnalisez les règles au cas par cas.
            </p>
        </field>
    </record>
</odoo>
