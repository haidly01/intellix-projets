<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pe_objective_tree" model="ir.ui.view">
        <field name="name">pe.objective.tree</field>
        <field name="model">pe.objective</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="name"/>
                <field name="objective_type"/>
                <field name="period"/>
                <field name="target_value"/>
                <field name="current_value"/>
                <field name="achievement_rate" widget="progressbar"/>
                <field name="status"/>
                <field name="date_deadline"/>
            </list>
        </field>
    </record>

    <record id="view_pe_objective_form" model="ir.ui.view">
        <field name="name">pe.objective.form</field>
        <field name="model">pe.objective</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activer" invisible="status != 'draft'"/>
                    <button name="action_mark_achieved" type="object" string="Clôturer" invisible="status not in ('active',)"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="profile_id"/>
                        <field name="employee_id"/>
                        <field name="contract_id" groups="people_engine.group_hr,people_engine.group_manager"/>
                        <field name="name"/>
                        <field name="objective_type"/>
                        <field name="period"/>
                        <field name="target_value"/>
                        <field name="current_value"/>
                        <field name="unit"/>
                        <field name="achievement_rate"/>
                        <field name="weight"/>
                        <field name="date_start"/>
                        <field name="date_deadline"/>
                        <field name="manager_id"/>
                        <field name="manager_approved"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pe_objective_search" model="ir.ui.view">
        <field name="name">pe.objective.search</field>
        <field name="model">pe.objective</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="objective_type"/>
                <field name="period"/>
                <filter string="Par semaine" name="period_weekly" domain="[('period', '=', 'weekly')]"/>
                <filter string="Par mois" name="period_monthly" domain="[('period', '=', 'monthly')]"/>
                <filter string="Par trimestre" name="period_quarterly" domain="[('period', '=', 'quarterly')]"/>
                <filter string="Par année" name="period_yearly" domain="[('period', '=', 'yearly')]"/>
                <group>
                    <filter string="Période" name="group_period" context="{'group_by': 'period'}"/>
                    <filter string="Type de KPI" name="group_objective_type" context="{'group_by': 'objective_type'}"/>
                    <filter string="Statut" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pe_objective" model="ir.actions.act_window">
        <field name="name">Objectifs</field>
        <field name="res_model">pe.objective</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_pe_objective_save_as_template" model="ir.actions.server">
        <field name="name">Enregistrer comme modèle</field>
        <field name="model_id" ref="model_pe_objective"/>
        <field name="binding_model_id" ref="model_pe_objective"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_save_as_template()</field>
    </record>
</odoo>
