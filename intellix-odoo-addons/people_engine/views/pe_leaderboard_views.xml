<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pe_leaderboard_tree" model="ir.ui.view">
        <field name="name">pe.leaderboard.tree</field>
        <field name="model">pe.leaderboard</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="participant_count"/>
                <field name="top_score"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_pe_leaderboard_form" model="ir.ui.view">
        <field name="name">pe.leaderboard.form</field>
        <field name="model">pe.leaderboard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_rebuild_lines" type="object" string="Recalculer le classement" class="btn-primary" groups="people_engine.group_hr"/>
                    <button name="action_publish" type="object" string="Publier" invisible="state == 'published'" groups="people_engine.group_hr"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="period_start"/>
                        <field name="period_end"/>
                        <field name="participant_count"/>
                        <field name="top_score"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="rank"/>
                            <field name="employee_id"/>
                            <field name="score_global"/>
                            <field name="badge_award_count"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pe_leaderboard" model="ir.actions.act_window">
        <field name="name">Classements People Engine</field>
        <field name="res_model">pe.leaderboard</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
