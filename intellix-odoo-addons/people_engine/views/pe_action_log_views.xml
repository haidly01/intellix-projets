<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pe_action_log_tree" model="ir.ui.view">
        <field name="name">pe.action.log.tree</field>
        <field name="model">pe.action.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="action_type"/>
                <field name="description"/>
                <field name="actor_id"/>
                <field name="actor_type"/>
                <field name="score_before"/>
                <field name="score_after"/>
            </list>
        </field>
    </record>

    <record id="action_pe_action_log" model="ir.actions.act_window">
        <field name="name">Journal actions RH</field>
        <field name="res_model">pe.action.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
