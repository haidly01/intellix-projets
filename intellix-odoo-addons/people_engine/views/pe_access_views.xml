<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pe_user_access_tree" model="ir.ui.view">
        <field name="name">res.users.pe.access.tree</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list string="Accès collaborateurs" create="false" class="pe-rh-theme">
                <field name="name"/>
                <field name="login"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="doorway_segment"/>
                <field name="doorway_role"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_pe_user_access_form" model="ir.ui.view">
        <field name="name">res.users.pe.access.form</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form string="Accès collaborateur" create="false" class="pe-rh-theme">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Compte">
                            <field name="login" readonly="1"/>
                            <field name="email"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
                        </group>
                        <group string="Doorway">
                            <field name="doorway_segment" readonly="1"/>
                            <field name="doorway_role" readonly="1"/>
                        </group>
                    </group>
                    <group string="Pipelines CRM assignés" colspan="2" groups="people_engine.group_admin,people_engine.group_hr">
                        <field name="doorway_assigned_pipeline_ids"
                               widget="many2many_tags"
                               domain="[('is_agence_doorway_pipeline', '=', True)]"
                               options="{'no_create': True}"/>
                        <div class="text-muted">
                            Accès CRM et Ventes limité à ces pipelines ; le collaborateur ne voit que ses propres leads et commandes.
                        </div>
                    </group>
                    <group string="Groupes RH" colspan="2" groups="people_engine.group_hr,people_engine.group_admin">
                        <field name="group_ids" widget="many2many_checkboxes"
                               domain="[('name', 'ilike', 'RH%')]"
                               options="{'no_create': True}"/>
                        <div class="text-muted">
                            Seuls un responsable RH ou un administrateur PE peuvent modifier les groupes.
                            Un collaborateur ne peut pas s'auto-attribuer des droits RH.
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pe_user_access" model="ir.actions.act_window">
        <field name="name">Accès &amp; permissions</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('share', '=', False)]</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_pe_user_access_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_pe_user_access_form')})]"/>
    </record>

    <record id="action_pe_user_access_server" model="ir.actions.server">
        <field name="name">Accès &amp; permissions</field>
        <field name="model_id" ref="model_pe_employee_profile"/>
        <field name="state">code</field>
        <field name="code">
pe_users = env['pe.employee.profile'].sudo().search([]).mapped('user_id').ids
action = env['ir.actions.act_window']._for_xml_id('people_engine.action_pe_user_access')
action['domain'] = [('share', '=', False), ('id', 'in', pe_users or [0])]
ctx = dict(env.context)
ctx['allowed_company_ids'] = env.user.company_ids.ids
action['context'] = ctx
        </field>
    </record>
</odoo>
