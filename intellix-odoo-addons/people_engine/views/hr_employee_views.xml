<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_pe" model="ir.ui.view">
        <field name="name">hr.employee.form.pe</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_pe_profile" type="object"
                        class="oe_stat_button" icon="fa-line-chart"
                        invisible="not pe_profile_count"
                        groups="people_engine.group_manager,people_engine.group_hr,base.group_system">
                    <field name="pe_profile_count" widget="statinfo" string="Profil RH"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_employee_tree_pe" model="ir.ui.view">
        <field name="name">hr.employee.tree.pe</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="pe_profile_count" column_invisible="1"/>
                <button name="action_open_pe_profile" type="object"
                        string="Profil PE" icon="fa-user-circle"
                        invisible="not pe_profile_count"
                        groups="base.group_system,people_engine.group_hr,people_engine.group_manager"/>
            </xpath>
        </field>
    </record>

    <record id="view_employee_kanban_pe" model="ir.ui.view">
        <field name="name">hr.employee.kanban.pe</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="pe_profile_count" groups="hr.group_hr_user"/>
            </xpath>
            <xpath expr="//footer" position="inside">
                <button name="action_open_pe_profile" type="object"
                        class="btn btn-sm btn-primary"
                        invisible="not pe_profile_count"
                        groups="base.group_system,people_engine.group_hr,people_engine.group_manager">
                    Profil PE
                </button>
            </xpath>
        </field>
    </record>
</odoo>
