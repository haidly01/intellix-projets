<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_pe_hr_dashboard" model="ir.actions.server">
        <field name="name">Tableau de bord RH</field>
        <field name="model_id" ref="model_pe_employee_profile"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_hr_dashboard()</field>
    </record>

    <record id="action_dashboard_hr" model="ir.actions.act_window">
        <field name="name">Tableau de bord RH</field>
        <field name="res_model">pe.employee.profile</field>
        <field name="view_mode">list,kanban,graph,pivot,form</field>
        <field name="search_view_id" ref="view_pe_employee_profile_search"/>
    </record>

    <record id="view_pe_hr_score_graph" model="ir.ui.view">
        <field name="name">pe.hr.score.graph</field>
        <field name="model">pe.performance.score</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="False">
                <field name="employee_id"/>
                <field name="score_global" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_pe_hr_scores_graph" model="ir.actions.act_window">
        <field name="name">Scores — vue graphique</field>
        <field name="res_model">pe.performance.score</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>
</odoo>
