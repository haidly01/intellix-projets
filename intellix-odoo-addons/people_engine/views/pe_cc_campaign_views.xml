<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pe_cc_campaign_list" model="ir.ui.view">
        <field name="name">pe.cc.campaign.list</field>
        <field name="model">pe.cc.campaign</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
                <field name="department_id"/>
                <field name="statut" widget="badge"/>
                <field name="call_count"/>
                <field name="demo_count"/>
                <field name="sale_count"/>
                <field name="conv_rate"/>
            </list>
        </field>
    </record>

    <record id="view_pe_cc_campaign_form" model="ir.ui.view">
        <field name="name">pe.cc.campaign.form</field>
        <field name="model">pe.cc.campaign</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="type"/>
                        <field name="department_id"/>
                        <field name="statut"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="vicidial_campaign_id"/>
                        <field name="objectif_appels"/>
                        <field name="objectif_conv_pct"/>
                    </group>
                    <group string="Stats">
                        <field name="call_count"/>
                        <field name="demo_count"/>
                        <field name="sale_count"/>
                        <field name="conv_rate"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pe_cc_campaign" model="ir.actions.act_window">
        <field name="name">Campagnes Call Center</field>
        <field name="res_model">pe.cc.campaign</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
