<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_generate_payslip_ma_wizard_form" model="ir.ui.view">
        <field name="name">generate.payslip.ma.wizard.form</field>
        <field name="model">generate.payslip.ma.wizard</field>
        <field name="arch" type="xml">
            <form string="Générer bulletin Maroc">
                <group>
                    <field name="contract_id"/>
                    <field name="employee_id"/>
                    <field name="period_start"/>
                    <field name="period_end"/>
                    <field name="gross_salary"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Générer" class="btn-primary"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_generate_payslip_ma_wizard" model="ir.actions.act_window">
        <field name="name">Générer bulletin Maroc</field>
        <field name="res_model">generate.payslip.ma.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
