<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_salary_rule_ma_list" model="ir.ui.view">
        <field name="name">hr.salary.rule.ma.list</field>
        <field name="model">hr.salary.rule.ma</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="computation_type"/>
                <field name="rate"/>
                <field name="ceiling"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_hr_salary_rule_ma_form" model="ir.ui.view">
        <field name="name">hr.salary.rule.ma.form</field>
        <field name="model">hr.salary.rule.ma</field>
        <field name="arch" type="xml">
            <form string="Règle salariale Maroc">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="company_id"/>
                            <field name="category"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="computation_type"/>
                            <field name="base_type"/>
                            <field name="rate"/>
                            <field name="employer_rate"/>
                            <field name="ceiling"/>
                            <field name="fixed_amount"/>
                            <field name="appears_on_payslip"/>
                        </group>
                    </group>
                    <group string="Comptabilité CGNC">
                        <field name="account_debit_id"/>
                        <field name="account_credit_id"/>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hr_salary_rule_ma" model="ir.actions.act_window">
        <field name="name">Règles salariales</field>
        <field name="res_model">hr.salary.rule.ma</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
