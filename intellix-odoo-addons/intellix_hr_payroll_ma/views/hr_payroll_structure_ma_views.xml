<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payroll_structure_ma_list" model="ir.ui.view">
        <field name="name">hr.payroll.structure.ma.list</field>
        <field name="model">hr.payroll.structure.ma</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_hr_payroll_structure_ma_form" model="ir.ui.view">
        <field name="name">hr.payroll.structure.ma.form</field>
        <field name="model">hr.payroll.structure.ma</field>
        <field name="arch" type="xml">
            <form string="Structure de paie Maroc">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                    <field name="rule_ids" widget="many2many_tags"/>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hr_payroll_structure_ma" model="ir.actions.act_window">
        <field name="name">Structures de paie</field>
        <field name="res_model">hr.payroll.structure.ma</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
