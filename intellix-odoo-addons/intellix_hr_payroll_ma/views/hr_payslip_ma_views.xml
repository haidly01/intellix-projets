<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_ma_list" model="ir.ui.view">
        <field name="name">hr.payslip.ma.list</field>
        <field name="model">hr.payslip.ma</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="period_label"/>
                <field name="gross_salary"/>
                <field name="net_salary"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state in ('validated', 'paid')"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>
    <record id="view_hr_payslip_ma_form" model="ir.ui.view">
        <field name="name">hr.payslip.ma.form</field>
        <field name="model">hr.payslip.ma</field>
        <field name="arch" type="xml">
            <form string="Bulletin de paie Maroc">
                <header>
                    <button name="action_compute" type="object" string="Calculer"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_validate" type="object" string="Valider"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_paid" type="object" string="Marquer payé"
                            invisible="state != 'validated'"/>
                    <button name="action_print_payslip" type="object" string="Imprimer PDF"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state not in ('draft', 'validated')"/>
                    <button name="action_draft" type="object" string="Remettre brouillon"
                            invisible="state != 'cancelled'" groups="intellix_hr_payroll_ma.group_hr_payroll_ma_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,validated,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'"/>
                            <field name="contract_id" readonly="1"/>
                            <field name="structure_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="period_start" readonly="state != 'draft'"/>
                            <field name="period_end" readonly="state != 'draft'"/>
                            <field name="gross_salary" readonly="state != 'draft'"/>
                            <field name="net_salary" readonly="1"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Dossier (lecture seule)">
                        <field name="cnss_number"/>
                        <field name="cin_number"/>
                    </group>
                    <notebook>
                        <page string="Lignes">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="base_amount"/>
                                    <field name="rate"/>
                                    <field name="amount"/>
                                    <field name="employer_amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Totaux">
                            <group>
                                <field name="total_employee_deductions"/>
                                <field name="total_employer_charges"/>
                            </group>
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_hr_payslip_ma" model="ir.actions.act_window">
        <field name="name">Bulletins Maroc</field>
        <field name="res_model">hr.payslip.ma</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 0}</field>
    </record>
</odoo>
