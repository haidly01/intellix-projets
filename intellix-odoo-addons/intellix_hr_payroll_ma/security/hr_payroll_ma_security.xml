<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_hr_payroll_ma_user" model="res.groups">
        <field name="name">Paie Maroc — Utilisateur</field>
        <field name="sequence">35</field>
        <field name="privilege_id" ref="people_engine.res_groups_privilege_people_engine"/>
    </record>
    <record id="group_hr_payroll_ma_manager" model="res.groups">
        <field name="name">Paie Maroc — Responsable</field>
        <field name="sequence">36</field>
        <field name="privilege_id" ref="people_engine.res_groups_privilege_people_engine"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_payroll_ma_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- RH PE : accès bulletins / exports paie Maroc -->
    <record id="people_engine.group_hr" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_hr_payroll_ma_user'))]"/>
    </record>

    <!-- RH admin PE + Odoo HR manager + superadmin : configuration paie Maroc -->
    <record id="people_engine.group_admin" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_hr_payroll_ma_manager'))]"/>
    </record>
    <record id="hr.group_hr_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_hr_payroll_ma_manager'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_hr_payroll_ma_manager'))]"/>
    </record>
</odoo>
