<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reno_immo_partner_kanban" model="ir.ui.view">
        <field name="name">renovation.partner.package.kanban.reno.immobilier</field>
        <field name="model">renovation.partner.package</field>
        <field name="priority">4</field>
        <field name="arch" type="xml">
            <kanban class="o_reno_immo_dash" default_order="health_status, name">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="package_type_id"/>
                <field name="leads_total"/>
                <field name="leads_used"/>
                <field name="leads_remaining"/>
                <field name="leads_remaining_pct"/>
                <field name="health_status"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="o_reno_partner_card {{ record.health_status.raw_value or '' }}">
                            <div class="o_reno_partner_name">
                                <field name="partner_id"/>
                            </div>
                            <div class="o_reno_partner_sub">
                                <field name="package_type_id"/>
                            </div>
                            <div class="o_reno_partner_meta">
                                <span t-attf-class="o_reno_health o_reno_health_{{ record.health_status.raw_value }}">
                                    <field name="health_status"/>
                                </span>
                            </div>
                            <div class="o_reno_progress_wrap">
                                <div class="o_reno_progress">
                                    <div class="o_reno_progress_bar"
                                         t-attf-style="width: {{ record.leads_remaining_pct.raw_value or 0 }}%;"/>
                                </div>
                                <div class="o_reno_progress_label">
                                    <field name="leads_remaining"/> restants / <field name="leads_total"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_reno_immo_partner_list" model="ir.ui.view">
        <field name="name">renovation.partner.package.list.reno.immobilier</field>
        <field name="model">renovation.partner.package</field>
        <field name="priority">4</field>
        <field name="arch" type="xml">
            <list decoration-success="health_status == 'actif_sain'"
                  decoration-warning="health_status == 'a_renouveler'"
                  decoration-danger="health_status == 'epuise'">
                <field name="partner_id"/>
                <field name="package_type_id"/>
                <field name="leads_total"/>
                <field name="leads_used"/>
                <field name="leads_remaining"/>
                <field name="leads_remaining_pct" widget="progressbar"/>
                <field name="health_status" widget="badge"
                       decoration-success="health_status == 'actif_sain'"
                       decoration-warning="health_status == 'a_renouveler'"
                       decoration-danger="health_status == 'epuise'"/>
                <field name="state"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>

    <record id="action_reno_immobilier_forfaits" model="ir.actions.act_window">
        <field name="name">Forfaits partenaires</field>
        <field name="res_model">renovation.partner.package</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_reno_immo_partner_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_reno_immo_partner_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('renovation_conciergerie.view_renovation_partner_package_form')})]"/>
    </record>
</odoo>
