<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_team_reno_immobilier" model="crm.team">
        <field name="name">Réno Immobilier</field>
        <field name="sequence">7</field>
        <field name="use_leads" eval="False"/>
        <field name="use_opportunities" eval="True"/>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="crm_team_reno_archive" model="crm.team">
        <field name="name">Réno — colonnes archivées</field>
        <field name="sequence">99</field>
        <field name="use_leads" eval="False"/>
        <field name="use_opportunities" eval="False"/>
        <field name="active" eval="False"/>
    </record>

    <record id="crm_stage_nouveau" model="crm.stage">
        <field name="name">Nouveau</field>
        <field name="sequence">10</field>
        <field name="fold" eval="False"/>
        <field name="team_ids" eval="[(4, ref('crm_team_reno_immobilier'))]"/>
    </record>
    <record id="crm_stage_en_contact" model="crm.stage">
        <field name="name">Contacté</field>
        <field name="sequence">20</field>
        <field name="fold" eval="False"/>
        <field name="team_ids" eval="[(4, ref('crm_team_reno_immobilier'))]"/>
    </record>
    <record id="crm_stage_attribue" model="crm.stage">
        <field name="name">Attribué</field>
        <field name="sequence">30</field>
        <field name="fold" eval="False"/>
        <field name="team_ids" eval="[(4, ref('crm_team_reno_immobilier'))]"/>
    </record>
    <record id="crm_stage_a_relancer" model="crm.stage">
        <field name="name">Relance</field>
        <field name="sequence">40</field>
        <field name="fold" eval="False"/>
        <field name="team_ids" eval="[(4, ref('crm_team_reno_immobilier'))]"/>
    </record>
    <record id="crm_stage_gagne" model="crm.stage">
        <field name="name">Gagné</field>
        <field name="sequence">50</field>
        <field name="fold" eval="False"/>
        <field name="is_won" eval="True"/>
        <field name="team_ids" eval="[(4, ref('crm_team_reno_immobilier'))]"/>
    </record>
    <record id="crm_stage_perdu" model="crm.stage">
        <field name="name">Perdu</field>
        <field name="sequence">60</field>
        <field name="fold" eval="True"/>
        <field name="team_ids" eval="[(4, ref('crm_team_reno_immobilier'))]"/>
    </record>
</odoo>
