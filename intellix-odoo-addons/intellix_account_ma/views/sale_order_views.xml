<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_intellix_billing_company" model="ir.ui.view">
        <field name="name">sale.order.form.intellix.billing.company</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="company_id"
                       string="Société de facturation"
                       readonly="1"
                       options="{'no_create': True}"
                       groups="!base.group_multi_company"/>
            </xpath>
            <xpath expr="//page[@name='other_information']//field[@name='company_id']" position="attributes">
                <attribute name="string">Société de facturation</attribute>
                <attribute name="readonly">1</attribute>
                <attribute name="groups">base.group_multi_company,!base.group_system</attribute>
            </xpath>
            <xpath expr="//page[@name='other_information']//field[@name='company_id']" position="after">
                <field name="company_id"
                       string="Société de facturation"
                       options="{'no_create': True}"
                       groups="base.group_system,base.group_multi_company"/>
            </xpath>
        </field>
    </record>
</odoo>
