<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_intellix_support_fix_proposal_list" model="ir.ui.view">
        <field name="name">intellix.support.fix.proposal.list</field>
        <field name="model">intellix.support.fix.proposal</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'executed'"
                  decoration-danger="state in ('failed', 'rejected')"
                  decoration-warning="state == 'pending_approval'">
                <field name="name"/>
                <field name="runbook_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'executed'"
                       decoration-danger="state in ('failed', 'rejected')"
                       decoration-warning="state == 'pending_approval'"
                       decoration-info="state == 'approved'"/>
                <field name="approved_by" optional="show"/>
                <field name="approved_date" optional="hide"/>
                <field name="create_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_intellix_support_fix_proposal_form" model="ir.ui.view">
        <field name="name">intellix.support.fix.proposal.form</field>
        <field name="model">intellix.support.fix.proposal</field>
        <field name="arch" type="xml">
            <form string="Proposition de correctif">
                <header>
                    <button name="action_submit_for_approval" type="object"
                            string="Soumettre" class="btn-primary"
                            invisible="state not in ('draft', 'rejected')"/>
                    <button name="action_approve" type="object"
                            string="Approuver" class="btn-primary"
                            groups="intellix_support.group_intellix_support_manager"
                            invisible="state != 'pending_approval'"/>
                    <button name="action_reject" type="object"
                            string="Rejeter" class="btn-secondary"
                            groups="intellix_support.group_intellix_support_manager"
                            invisible="state != 'pending_approval'"/>
                    <button name="action_execute" type="object"
                            string="Exécuter" class="btn-primary"
                            groups="intellix_support.group_intellix_support_manager"
                            invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending_approval,approved,executed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="ticket_id" readonly="1"/>
                            <field name="runbook_id" readonly="1"/>
                            <field name="diagnostic_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Étapes" name="steps">
                            <field name="steps_html" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Exécution" name="execution"
                              invisible="not execution_log and not error_message">
                            <field name="execution_log" readonly="1" nolabel="1"/>
                            <field name="error_message" readonly="1"
                                   invisible="not error_message"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
