<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_support" model="ir.ui.view">
        <field name="name">crm.lead.form.support</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_support_tickets"
                        class="oe_stat_button" icon="fa-life-ring"
                        groups="intellix_support.group_intellix_support_user"
                        invisible="support_ticket_count == 0">
                    <field name="support_ticket_count" widget="statinfo" string="Support"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_support_ticket" type="object"
                        string="Ticket support" class="btn-secondary"
                        groups="intellix_support.group_intellix_support_user"/>
            </xpath>
        </field>
    </record>
</odoo>
