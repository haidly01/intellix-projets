<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_intellix_support_stage_tree" model="ir.ui.view">
        <field name="name">intellix.support.stage.list</field>
        <field name="model">intellix.support.stage</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="fold"/>
                <field name="is_closed"/>
            </list>
        </field>
    </record>

    <record id="action_intellix_support_stage" model="ir.actions.act_window">
        <field name="name">Étapes support</field>
        <field name="res_model">intellix.support.stage</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
