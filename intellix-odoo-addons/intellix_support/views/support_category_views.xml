<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_intellix_support_category_tree" model="ir.ui.view">
        <field name="name">intellix.support.category.list</field>
        <field name="model">intellix.support.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_intellix_support_category" model="ir.actions.act_window">
        <field name="name">Catégories support</field>
        <field name="res_model">intellix.support.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
