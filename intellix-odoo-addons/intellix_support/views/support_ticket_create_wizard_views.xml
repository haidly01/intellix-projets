<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_intellix_support_ticket_create_wizard_form" model="ir.ui.view">
        <field name="name">intellix.support.ticket.create.wizard.form</field>
        <field name="model">intellix.support.ticket.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Nouveau ticket support" class="intellix-support-create-wizard">
                <sheet>
                    <div class="intellix-wizard-intro mb-3">
                        <p class="text-muted mb-0">
                            Décrivez votre demande étape par étape. Vous pourrez joindre
                            une capture d'écran après la création via le composer en bas de page.
                        </p>
                    </div>
                    <group>
                        <group string="1 · Organisation">
                            <field name="partner_id"
                                   domain="['|', ('is_company', '=', True), ('user_ids', '!=', False)]"
                                   context="{'support_ticket_partner_picker': 1}"
                                   options="{'no_create': True}"
                                   placeholder="Sélectionner l'organisation…"/>
                        </group>
                        <group string="2 · Portée">
                            <field name="user_scope" widget="radio"/>
                            <field name="scope_group_id"
                                   invisible="user_scope != 'group'"
                                   required="user_scope == 'group'"/>
                            <field name="contact_user_id"
                                   widget="many2one_avatar_user"
                                   invisible="user_scope != 'specific'"
                                   required="user_scope == 'specific'"
                                   domain="[('partner_id', 'child_of', partner_id), ('active', '=', True)]"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="3 · Module">
                            <field name="category_id" placeholder="CRM, RH, Dialer…"/>
                        </group>
                        <group string="Type de demande">
                            <field name="ticket_type" widget="radio"/>
                        </group>
                    </group>
                    <group string="4 · Description">
                        <field name="subject" placeholder="Résumé court du problème ou de la demande"/>
                        <field name="description" nolabel="1"
                               placeholder="Décrivez le contexte, les étapes pour reproduire, le résultat attendu…"/>
                        <div class="intellix-attachment-hint text-muted">
                            <i class="fa fa-paperclip"/> Vous pouvez joindre une capture d'écran
                            via le composer après création du ticket.
                        </div>
                    </group>
                    <group>
                        <field name="launch_diagnostic"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_ticket" type="object"
                            string="Créer et lancer diagnostic"
                            class="btn-primary"
                            invisible="not launch_diagnostic"/>
                    <button name="action_create_ticket" type="object"
                            string="Créer le ticket"
                            class="btn-primary"
                            invisible="launch_diagnostic"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_intellix_support_ticket_create_wizard" model="ir.actions.act_window">
        <field name="name">Nouveau ticket</field>
        <field name="res_model">intellix.support.ticket.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_partner_id': user.partner_id.commercial_partner_id.id}</field>
    </record>
</odoo>
