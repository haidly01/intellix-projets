<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_intellix_support_runbook_tree" model="ir.ui.view">
        <field name="name">intellix.support.runbook.list</field>
        <field name="model">intellix.support.runbook</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="phase"/>
                <field name="requires_approval"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_intellix_support_runbook_form" model="ir.ui.view">
        <field name="name">intellix.support.runbook.form</field>
        <field name="model">intellix.support.runbook</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="category_id"/>
                        <field name="phase"/>
                        <field name="requires_approval"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_intellix_support_runbook" model="ir.actions.act_window">
        <field name="name">Runbooks</field>
        <field name="res_model">intellix.support.runbook</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
