<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="intellix_support.KanbanView" t-inherit="web.KanbanView" t-inherit-mode="primary">
        <xpath expr="//div[@t-ref='root']" position="attributes">
            <attribute name="class" add="intellix-support-scope" separator=" "/>
        </xpath>
        <xpath expr="//div[@t-ref='root']/Layout" position="before">
            <div class="intellix-support-kpi-bar" t-if="supportKpis.loaded">
                <div class="intellix-support-kpi-item">
                    <div class="intellix-support-kpi-val text-indigo" t-esc="supportKpis.data.open_total"/>
                    <div class="intellix-support-kpi-lbl">Total ouverts</div>
                </div>
                <div class="intellix-support-kpi-item">
                    <div class="intellix-support-kpi-val text-danger" t-esc="supportKpis.data.sla_breach"/>
                    <div class="intellix-support-kpi-lbl">SLA breach</div>
                </div>
                <div class="intellix-support-kpi-item">
                    <div class="intellix-support-kpi-val text-warning" t-esc="supportKpis.data.avg_resolution"/>
                    <div class="intellix-support-kpi-lbl">Temps moy. résolution</div>
                </div>
                <div class="intellix-support-kpi-item">
                    <div class="intellix-support-kpi-val text-success" t-esc="supportKpis.data.satisfaction"/>
                    <div class="intellix-support-kpi-lbl">Satisfaction client</div>
                </div>
                <div class="intellix-support-kpi-item">
                    <div class="intellix-support-kpi-val text-purple" t-esc="supportKpis.data.resolved_month"/>
                    <div class="intellix-support-kpi-lbl">Résolus ce mois</div>
                </div>
            </div>
        </xpath>
    </t>

</templates>
