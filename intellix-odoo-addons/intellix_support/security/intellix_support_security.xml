<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_intellix_support" model="ir.module.category">
        <field name="name">Support Intellix</field>
        <field name="sequence">46</field>
    </record>

    <record id="res_groups_privilege_intellix_support" model="res.groups.privilege">
        <field name="name">Support Intellix</field>
        <field name="sequence">46</field>
        <field name="category_id" ref="module_category_intellix_support"/>
    </record>

    <!-- Onboarding clients : tous les utilisateurs internes voient Support et créent des tickets -->
    <record id="group_intellix_support_user" model="res.groups">
        <field name="name">Utilisateur plateforme</field>
        <field name="comment">Accès Support Intellix : créer et suivre les tickets de sa société. Attribué automatiquement à chaque utilisateur interne lors de l'onboarding.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_intellix_support"/>
    </record>

    <record id="group_intellix_support_manager" model="res.groups">
        <field name="name">Responsable Intellix</field>
        <field name="comment">Équipe Intellix / Doorway : tous les tickets, configuration, runbooks.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_intellix_support"/>
        <field name="implied_ids" eval="[(4, ref('group_intellix_support_user'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_intellix_support_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_intellix_support_manager'))]"/>
    </record>
</odoo>
