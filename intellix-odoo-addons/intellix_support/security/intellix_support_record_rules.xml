<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Utilisateurs plateforme : tickets de leur société uniquement -->
    <record id="rule_support_ticket_company" model="ir.rule">
        <field name="name">Support : tickets de ma société</field>
        <field name="model_id" ref="model_intellix_support_ticket"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_intellix_support_user'))]"/>
    </record>

    <record id="rule_support_ticket_manager_all" model="ir.rule">
        <field name="name">Support : tous les tickets (responsable Intellix)</field>
        <field name="model_id" ref="model_intellix_support_ticket"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_intellix_support_manager'))]"/>
    </record>

    <record id="rule_support_diagnostic_company" model="ir.rule">
        <field name="name">Support : diagnostics de ma société</field>
        <field name="model_id" ref="model_intellix_support_diagnostic"/>
        <field name="domain_force">[('ticket_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_intellix_support_user'))]"/>
    </record>

    <record id="rule_support_diagnostic_manager_all" model="ir.rule">
        <field name="name">Support : tous les diagnostics (responsable Intellix)</field>
        <field name="model_id" ref="model_intellix_support_diagnostic"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_intellix_support_manager'))]"/>
    </record>
</odoo>
