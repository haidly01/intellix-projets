<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_intellix_support_ticket" model="ir.sequence">
        <field name="name">Ticket support Intellix</field>
        <field name="code">intellix.support.ticket</field>
        <field name="prefix">SUP-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_intellix_support_fix_proposal" model="ir.sequence">
        <field name="name">Proposition correctif support</field>
        <field name="code">intellix.support.fix.proposal</field>
        <field name="prefix">FIX-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
