<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_traffic_report_list" model="ir.ui.view">
        <field name="name">doorway.traffic.report.list</field>
        <field name="model">doorway.traffic.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="pipeline_id"/>
                <field name="period"/>
                <field name="date_from"/>
                <field name="date_to"/>
            </list>
        </field>
    </record>

    <record id="view_traffic_report_form" model="ir.ui.view">
        <field name="name">doorway.traffic.report.form</field>
        <field name="model">doorway.traffic.report</field>
        <field name="arch" type="xml">
            <form string="Rapport Traffic Manager">
                <sheet>
                    <group>
                        <field name="foundation_id"/>
                        <field name="pipeline_id"/>
                        <field name="period"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="summary"/>
                        <field name="wins"/>
                        <field name="concerns"/>
                        <field name="next_actions"/>
                        <field name="kpi_vs_objectives"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_traffic_reports" model="ir.actions.act_window">
        <field name="name">Rapports</field>
        <field name="res_model">doorway.traffic.report</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
