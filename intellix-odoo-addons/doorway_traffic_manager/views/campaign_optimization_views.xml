    <record id="action_server_sync_optimize_all" model="ir.actions.server">
        <field name="name">Sync + optimiser tout (7j)</field>
        <field name="model_id" ref="model_doorway_traffic_campaign"/>
        <field name="binding_model_id" ref="model_doorway_traffic_campaign"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
