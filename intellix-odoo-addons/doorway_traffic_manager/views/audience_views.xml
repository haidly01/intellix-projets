<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_audience_list" model="ir.ui.view">
        <field name="name">doorway.audience.list</field>
        <field name="model">doorway.audience</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="campaign_id"/>
                <field name="audience_type"/>
                <field name="remarketing_source" optional="show"/>
                <field name="window_days" optional="show"/>
                <field name="platform"/>
                <field name="targeting_rationale" optional="show"/>
                <field name="ai_status" widget="badge"
                       decoration-warning="ai_status == 'proposed'"
                       decoration-success="ai_status in ('approved', 'active')"/>
                <field name="estimated_size"/>
                <field name="cpa"/>
                <field name="ctr"/>
                <button name="action_approve" type="object" string="Approuver"
                        icon="fa-check" invisible="ai_status != 'proposed'"/>
                <button name="action_reject" type="object" string="Ignorer"
                        icon="fa-times" invisible="ai_status != 'proposed'"/>
            </list>
        </field>
    </record>

    <record id="view_audience_form" model="ir.ui.view">
        <field name="name">doorway.audience.form</field>
        <field name="model">doorway.audience</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approuver"
                            invisible="ai_status != 'proposed'"/>
                    <button name="action_reject" type="object" string="Ignorer"
                            invisible="ai_status != 'proposed'"/>
                    <button name="action_activate" type="object" string="Activer"
                            invisible="ai_status != 'approved'"/>
                    <field name="ai_status" widget="statusbar"
                           statusbar_visible="proposed,approved,active"/>
                </header>
                <sheet>
                    <group>
                        <field name="campaign_id"/>
                        <field name="name"/>
                        <field name="audience_type"/>
                        <field name="platform"/>
                        <field name="source"/>
                        <field name="estimated_size"/>
                    </group>
                    <group string="Remarketing"
                           invisible="audience_type != 'retargeting'">
                        <field name="remarketing_source"/>
                        <field name="window_days"/>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="targeting"/>
                        <field name="targeting_rationale"/>
                    </group>
                    <group string="Performance">
                        <field name="impressions" readonly="1"/>
                        <field name="ctr" readonly="1"/>
                        <field name="cpa" readonly="1"/>
                        <field name="frequency" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_audiences" model="ir.actions.act_window">
        <field name="name">Audiences</field>
        <field name="res_model">doorway.audience</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ai_status', '=', 'proposed')]</field>
        <field name="context">{'search_default_proposed': 1}</field>
    </record>
</odoo>
