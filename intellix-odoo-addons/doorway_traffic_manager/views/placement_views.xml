<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_placement_list" model="ir.ui.view">
        <field name="name">doorway.placement.list</field>
        <field name="model">doorway.placement</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="campaign_id"/>
                <field name="placement_group"/>
                <field name="priority" widget="badge"
                       decoration-success="priority == 'high'"
                       decoration-warning="priority == 'medium'"
                       decoration-danger="priority == 'exclude'"/>
                <field name="placement_rationale" optional="show"/>
                <field name="ai_status" widget="badge"
                       decoration-warning="ai_status == 'proposed'"
                       decoration-success="ai_status in ('approved', 'active')"/>
                <button name="action_approve" type="object" string="Approuver"
                        icon="fa-check" invisible="ai_status != 'proposed'"/>
                <button name="action_reject" type="object" string="Ignorer"
                        icon="fa-times" invisible="ai_status != 'proposed'"/>
            </list>
        </field>
    </record>

    <record id="view_placement_form" model="ir.ui.view">
        <field name="name">doorway.placement.form</field>
        <field name="model">doorway.placement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approuver"
                            invisible="ai_status != 'proposed'"/>
                    <button name="action_reject" type="object" string="Ignorer"
                            invisible="ai_status != 'proposed'"/>
                    <button name="action_activate" type="object" string="Activer"
                            invisible="ai_status != 'approved'"/>
                    <field name="ai_status" widget="statusbar"
                           statusbar_visible="proposed,approved,active"/>
                </header>
                <sheet>
                    <group>
                        <field name="campaign_id"/>
                        <field name="name"/>
                        <field name="placement_group"/>
                        <field name="platform"/>
                        <field name="priority"/>
                    </group>
                    <group>
                        <field name="placement_rationale"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_placements" model="ir.actions.act_window">
        <field name="name">Placements</field>
        <field name="res_model">doorway.placement</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ai_status', '=', 'proposed')]</field>
    </record>
</odoo>
