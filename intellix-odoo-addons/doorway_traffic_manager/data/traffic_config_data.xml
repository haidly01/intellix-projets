<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="icp_meta_ads_access_token" model="ir.config_parameter">
        <field name="key">doorway_traffic_manager.meta_ads_access_token</field>
        <field name="value"/>
    </record>
    <record id="icp_google_ads_refresh_token" model="ir.config_parameter">
        <field name="key">doorway_traffic_manager.google_ads_refresh_token</field>
        <field name="value"/>
    </record>
    <record id="icp_tiktok_ads_access_token" model="ir.config_parameter">
        <field name="key">doorway_traffic_manager.tiktok_ads_access_token</field>
        <field name="value"/>
    </record>
    <record id="icp_ga4_credentials_path" model="ir.config_parameter">
        <field name="key">doorway_traffic_manager.ga4_credentials_path</field>
        <field name="value"/>
    </record>
    <record id="icp_canva_edit_url_template" model="ir.config_parameter">
        <field name="key">doorway_traffic_manager.canva_edit_url_template</field>
        <field name="value">https://www.canva.com/design/{design_id}/edit</field>
    </record>
    <record id="icp_canva_mcp_url" model="ir.config_parameter">
        <field name="key">doorway_social_ia.canva_mcp_url</field>
        <field name="value"/>
    </record>
    <record id="icp_heygen_api_key" model="ir.config_parameter">
        <field name="key">doorway_social_ia.heygen_api_key</field>
        <field name="value"/>
    </record>
</odoo>
