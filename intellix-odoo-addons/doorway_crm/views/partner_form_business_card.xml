<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_business_card" model="ir.ui.view">
        <field name="name">res.partner.form.business.card</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="before">
                <div class="oe_button_box doorway_bcard_mobile_btn">
                    <button name="action_open_business_card_scan" type="object"
                            class="btn btn-primary doorway_bcard_scan_btn"
                            string="📷 Carte de visite"
                            title="Photographier une carte de visite pour remplir la fiche"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_partner_business_card_scan_new" model="ir.actions.server">
        <field name="name">Nouveau contact (carte)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">
card = env['doorway.business.card']
action = card.action_open_scan_client(target_model='res.partner')
        </field>
    </record>
</odoo>
