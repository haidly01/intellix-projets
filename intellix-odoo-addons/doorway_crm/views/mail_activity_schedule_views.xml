<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="doorway_mail_activity_schedule_view_form" model="ir.ui.view">
        <field name="name">mail.activity.schedule.form.doorway</field>
        <field name="model">mail.activity.schedule</field>
        <field name="inherit_id" ref="mail.mail_activity_schedule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_deadline']" position="before">
                <field name="doorway_scheduled_datetime"
                       string="Date et heure"
                       widget="datetime"/>
                <field name="doorway_scheduled_duration"
                       invisible="not doorway_scheduled_datetime"/>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="string">Date d'échéance</attribute>
                <attribute name="readonly">doorway_scheduled_datetime</attribute>
            </xpath>
        </field>
    </record>
</odoo>
