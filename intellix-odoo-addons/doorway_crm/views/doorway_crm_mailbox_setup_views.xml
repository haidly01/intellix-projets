<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_doorway_crm_mailbox_setup_form" model="ir.ui.view">

        <field name="name">doorway.crm.mailbox.setup.form</field>

        <field name="model">doorway.crm.mailbox.setup</field>

        <field name="arch" type="xml">

            <form string="Configurer une boîte mail">

                <group>

                    <group string="Compte">

                        <field name="mailbox_id" invisible="1"/>

                        <field name="name" placeholder="Ex. Prospection, Support…"/>

                        <field name="email" placeholder="vous@domaine.com"/>

                        <field name="password" password="True"

                               placeholder="Laisser vide pour conserver l'existant"/>

                        <field name="is_default"/>

                        <field name="create_crm_leads"/>

                    </group>

                    <group string="Réception (IMAP)">

                        <field name="imap_server"/>

                        <field name="imap_port"/>

                    </group>

                    <group string="Envoi (SMTP)">

                        <field name="smtp_server"/>

                        <field name="smtp_port"/>

                        <field name="smtp_encryption"/>

                    </group>

                </group>

                <footer>

                    <button name="action_save_mailbox" type="object" string="Enregistrer" class="btn-primary"/>

                    <button string="Annuler" special="cancel" class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>



    <record id="action_doorway_crm_mailbox_setup" model="ir.actions.act_window">

        <field name="name">Ajouter une boîte mail</field>

        <field name="res_model">doorway.crm.mailbox.setup</field>

        <field name="view_mode">form</field>

        <field name="target">new</field>

    </record>

</odoo>

