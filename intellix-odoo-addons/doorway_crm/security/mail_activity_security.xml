<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Équipe interne : activités de tout le monde SAUF Zakaria
        (Coins Marocain / voyageurs). Karine et Zak les voient via
        l'onglet Coins Marocain (règle doorway_crm.rule_mail_activity_coins_marocain_tab).
    -->
    <record id="rule_mail_activity_doorway_internal" model="ir.rule">
        <field name="name">Activités : équipe interne (hors Zakaria)</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id.login', '!=', 'zakaria@agencedoorway.com')]</field>
        <field name="groups" eval="[(4, ref('renovation_conciergerie.group_doorway_equipe_interne')),
                                    (4, ref('renovation_conciergerie.group_agence_doorway_crm')),
                                    (4, ref('renovation_conciergerie.group_doorway_role_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="calendar.calendar_event_rule_employee" model="ir.rule">
        <field name="name">All Calendar Event for employees (hors organisateur Zakaria)</field>
        <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('partner_ids', 'in', user.partner_id.id), ('user_id.login', '!=', 'zakaria@agencedoorway.com')]</field>
    </record>
</odoo>
