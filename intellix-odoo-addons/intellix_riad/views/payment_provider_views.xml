<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_provider_form_riad" model="ir.ui.view">
        <field name="name">payment.provider.form.riad</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group string="ChariBaaS / Pay10" invisible="code not in ('charibaas', 'pay10')">
                    <field name="charibaas_merchant_id" password="True"/>
                    <field name="charibaas_api_key" password="True"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
