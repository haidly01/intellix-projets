<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_riad_police_fiche_list" model="ir.ui.view">
        <field name="name">intellix.riad.police.fiche.list</field>
        <field name="model">intellix.riad.police.fiche</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="lastname"/>
                <field name="firstname"/>
                <field name="nationality_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="reservation_id"/>
                <field name="state" widget="badge"/>
                <field name="retention_until" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_riad_police_fiche_form" model="ir.ui.view">
        <field name="name">intellix.riad.police.fiche.form</field>
        <field name="model">intellix.riad.police.fiche</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_print" type="object" string="Imprimer / exporter" class="btn-primary"
                            invisible="is_moroccan"/>
                    <button name="action_mark_exported" type="object" string="Marquer transmise"
                            invisible="state == 'exported' or is_moroccan"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,ready,completed,exported"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not missing_fields">
                        Champs manquants : <field name="missing_fields"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not is_moroccan">
                        Nationalité marocaine : aucune fiche de police à transmettre.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="establishment_id"/>
                            <field name="reservation_id"/>
                            <field name="lastname"/>
                            <field name="firstname"/>
                            <field name="birth_date"/>
                            <field name="birth_place"/>
                            <field name="nationality_id"/>
                            <field name="is_moroccan" invisible="1"/>
                            <field name="requires_fiche" invisible="1"/>
                        </group>
                        <group>
                            <field name="id_document_type"/>
                            <field name="passport_number"/>
                            <field name="entry_date"/>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="stay_nights"/>
                            <field name="establishment_address"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="retention_until"/>
                            <field name="exported_at" invisible="not exported_at"/>
                            <field name="signed_at" invisible="not signed_at"/>
                            <field name="signed_ip" invisible="not signed_ip"/>
                            <field name="signature_id" readonly="1" invisible="not signature_id"/>
                        </group>
                    </group>
                    <group string="Passeport — photo avant arrivée">
                        <field name="passport_image" filename="passport_filename" widget="image"/>
                        <field name="passport_filename" invisible="1"/>
                        <field name="signature_image" widget="image" invisible="not signature_image"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_riad_police_fiche" model="ir.actions.act_window">
        <field name="name">Fiches de police</field>
        <field name="res_model">intellix.riad.police.fiche</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
