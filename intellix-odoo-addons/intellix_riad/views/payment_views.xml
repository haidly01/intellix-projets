<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_riad_establishment_payment_form" model="ir.ui.view">
        <field name="name">intellix.riad.establishment.payment.form</field>
        <field name="model">intellix.riad.establishment</field>
        <field name="arch" type="xml">
            <form string="Paiement établissement">
                <sheet>
                    <group>
                        <group>
                            <field name="property_id" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="payment_brand"/>
                        </group>
                        <group>
                            <field name="compatible_provider_ids" invisible="1"/>
                            <field name="payment_provider_id"
                                   domain="[('id', 'in', compatible_provider_ids)]"/>
                            <field name="payment_provider_state"/>
                            <button name="action_ensure_test_payment_provider"
                                    type="object"
                                    string="Connecter une passerelle (mode test)"
                                    class="btn-primary"/>
                            <button name="action_open_payment_provider"
                                    type="object"
                                    string="Ouvrir les clés API (chiffrées Odoo)"
                                    class="btn-secondary"
                                    invisible="not payment_provider_id"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        CAD / Coins Québec : Authorize.net natif Odoo 19.
                        DH / Coins Marocain : ChariBaaS ou Pay10.
                        Une passerelle par établissement — pas de clé globale.
                        L’encaissement se fait manuellement depuis la réservation.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_riad_payment_settings" model="ir.actions.act_window">
        <field name="name">Paiement</field>
        <field name="res_model">intellix.riad.establishment</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_riad_establishment_list"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_riad_establishment_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_riad_establishment_payment_form')})]"/>
    </record>
</odoo>
