<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ota_review_snapshot_tree" model="ir.ui.view">
        <field name="name">intellix.riad.ota.review.snapshot.tree</field>
        <field name="model">intellix.riad.ota.review.snapshot</field>
        <field name="arch" type="xml">
            <list>
                <field name="captured_at"/>
                <field name="establishment_id"/>
                <field name="platform"/>
                <field name="booking_overall"/>
                <field name="airbnb_overall"/>
                <field name="source_note"/>
            </list>
        </field>
    </record>
    <record id="view_ota_review_snapshot_form" model="ir.ui.view">
        <field name="name">intellix.riad.ota.review.snapshot.form</field>
        <field name="model">intellix.riad.ota.review.snapshot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="establishment_id"/>
                        <field name="platform"/>
                        <field name="captured_at"/>
                        <field name="source_note"/>
                    </group>
                    <group string="Booking.com (/10)" invisible="platform != 'booking'">
                        <field name="booking_overall"/>
                        <field name="score_personnel"/>
                        <field name="score_proprete"/>
                        <field name="score_emplacement"/>
                        <field name="score_confort"/>
                        <field name="score_equipements"/>
                        <field name="score_rapport_qualite_prix"/>
                        <field name="score_wifi"/>
                    </group>
                    <group string="Airbnb (/5 + globale distincte)" invisible="platform != 'airbnb'">
                        <field name="airbnb_overall"/>
                        <field name="score_proprete"/>
                        <field name="score_exactitude"/>
                        <field name="score_checkin"/>
                        <field name="score_communication"/>
                        <field name="score_emplacement"/>
                        <field name="score_valeur"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ota_review_snapshot" model="ir.actions.act_window">
        <field name="name">Snapshots avis OTA</field>
        <field name="res_model">intellix.riad.ota.review.snapshot</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
