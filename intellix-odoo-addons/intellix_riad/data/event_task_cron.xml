<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_riad_event_task_reminders" model="ir.cron">
        <field name="name">Module Hébergement — rappels échéances tâches événements</field>
        <field name="model_id" ref="model_intellix_riad_event_task"/>
        <field name="state">code</field>
        <field name="code">model.sudo().cron_send_deadline_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=7, minute=30, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
