<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doorway_cross_sell_line_list" model="ir.ui.view">
        <field name="name">doorway.cross.sell.line.list</field>
        <field name="model">doorway.cross.sell.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="date_detection"/>
                <field name="lead_origine_id"/>
                <field name="vertical_origine"/>
                <field name="vertical_secondaire"/>
                <field name="checklist_key" optional="hide"/>
                <field name="statut"/>
                <field name="bonus_calcule"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="agent_credite_manuel_id" optional="hide"/>
                <field name="agent_credite_id"/>
                <field name="date_validation"/>
            </list>
        </field>
    </record>

    <record id="view_doorway_cross_sell_line_form" model="ir.ui.view">
        <field name="name">doorway.cross.sell.line.form</field>
        <field name="model">doorway.cross.sell.line</field>
        <field name="arch" type="xml">
            <form string="Ligne de cross-sell">
                <sheet>
                    <group>
                        <group>
                            <field name="lead_origine_id"/>
                            <field name="vertical_origine"/>
                            <field name="vertical_secondaire"/>
                            <field name="statut"/>
                            <field name="moment_detection"/>
                        </group>
                        <group>
                            <field name="call_journal_id"/>
                            <field name="agent_credite_manuel_visible" invisible="1"/>
                            <field name="agent_credite_manuel_editable" invisible="1"/>
                            <field
                                name="agent_credite_manuel_id"
                                invisible="not agent_credite_manuel_visible"
                                readonly="not agent_credite_manuel_editable"
                            />
                            <field name="agent_credite_id" readonly="1"/>
                            <field name="date_detection"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="bonus_calcule" readonly="1"/>
                            <field name="date_validation" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_doorway_cross_sell_line" model="ir.actions.act_window">
        <field name="name">Cross-sell</field>
        <field name="res_model">doorway.cross.sell.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_doorway_cross_sell"
        name="Cross-sell"
        parent="crm.crm_menu_root"
        action="action_doorway_cross_sell_line"
        groups="renovation_conciergerie.group_agence_doorway_crm"
        sequence="55"
    />
</odoo>
