<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_social_account_kanban" model="ir.ui.view">
        <field name="name">doorway.social.account.kanban</field>
        <field name="model">doorway.social.account</field>
        <field name="arch" type="xml">
            <kanban class="o_doorway_social_accounts" create="1" default_group_by="platform">
                <field name="name"/>
                <field name="platform"/>
                <field name="connection_state"/>
                <field name="page_count"/>
                <field name="tiktok_username"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_card doorway_social_account_card">
                            <div class="fw-bold text-capitalize">
                                <field name="platform"/>
                            </div>
                            <div class="fs-5"><field name="name"/></div>
                            <div class="text-muted" t-if="record.tiktok_username.raw_value">
                                @<t t-esc="record.tiktok_username.value"/>
                            </div>
                            <div class="mt-2">
                                <span t-attf-class="badge #{record.connection_state.raw_value === 'connected' ? 'text-bg-success' : (record.connection_state.raw_value === 'expired' ? 'text-bg-warning' : 'text-bg-secondary')}">
                                    <field name="connection_state"/>
                                </span>
                            </div>
                            <div class="mt-2 text-muted" t-if="record.connection_state.raw_value === 'connected'">
                                <field name="page_count"/> page(s)
                            </div>
                            <div class="mt-3" t-if="record.connection_state.raw_value !== 'connected'">
                                <button name="action_connect" type="object"
                                        class="btn btn-sm btn-primary" string="Connecter"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_social_account_form" model="ir.ui.view">
        <field name="name">doorway.social.account.form</field>
        <field name="model">doorway.social.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate_connection" type="object"
                            string="Vérifier connexion"
                            invisible="platform not in ('facebook', 'instagram', 'tiktok')"/>
                    <button name="action_sync_from_channels" type="object"
                            string="Sync depuis canaux OAuth"
                            invisible="platform not in ('linkedin', 'gmb')"/>
                    <button name="action_connect" type="object" string="Connecter / Reconnecter"
                            class="btn-primary"
                            invisible="connection_state == 'connected' and platform != 'tiktok'"/>
                    <field name="connection_state" widget="statusbar"
                           statusbar_visible="disconnected,expired,connected"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="platform"/>
                        <field name="pipeline_id"/>
                        <field name="external_account_id"/>
                    </group>
                    <group string="TikTok (Content Posting API)" invisible="platform != 'tiktok'">
                        <field name="tiktok_username" placeholder="coinsmarrakech"/>
                        <div class="alert alert-info mb-0" role="status" colspan="2">
                            Page Coins Marocain :
                            <strong>https://www.tiktok.com/@coinsmarrakech</strong>.
                            En sandbox, ajoutez ce compte dans Target users sinon
                            TikTok affiche « client_key ». Redirect URI :
                            <strong>https://intellixcrm.com/doorway/publication/tiktok/oauth/callback</strong>.
                            Les vidéos restent privées (SELF_ONLY) jusqu’à l’audit Production.
                        </div>
                    </group>
                    <group string="WhatsApp (réception messages)" invisible="platform != 'whatsapp'">
                        <field name="whatsapp_display_number" readonly="1"/>
                        <field name="whatsapp_webhook_url" readonly="1" widget="CopyClipboardChar"/>
                        <field name="whatsapp_verify_token" readonly="1" widget="CopyClipboardChar"/>
                        <div class="alert alert-info mb-0" role="status">
                            Dans Meta Developer → App Intellix → WhatsApp → Configuration,
                            configurez l'URL webhook ci-dessus, le token de vérification,
                            et abonnez le champ <strong>messages</strong>.
                        </div>
                    </group>
                    <group string="HeyGen (avatar vidéo)">
                        <field name="heygen_avatar_id"/>
                        <field name="heygen_voice_id"/>
                        <field name="heygen_language"/>
                    </group>
                    <notebook>
                        <page string="Pinterest" invisible="platform != 'pinterest'">
                            <field name="pinterest_board_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="external_board_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Groupes Facebook" invisible="platform != 'facebook'">
                            <field name="facebook_group_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="external_group_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Profils LinkedIn" invisible="platform != 'linkedin'">
                            <field name="linkedin_profile_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="profile_type"/>
                                    <field name="external_urn"/>
                                    <field name="channel_config_id"/>
                                    <field name="active"/>
                                </list>
                            </field>
                            <field name="linkedin_group_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="external_group_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Établissements GMB" invisible="platform != 'gmb'">
                            <field name="gmb_location_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="gmb_account_id"/>
                                    <field name="gmb_location_id"/>
                                    <field name="channel_config_id"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_social_account_list" model="ir.ui.view">
        <field name="name">doorway.social.account.list</field>
        <field name="model">doorway.social.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tiktok_username" optional="show"/>
                <field name="platform"/>
                <field name="connection_state" widget="badge"
                       decoration-success="connection_state == 'connected'"
                       decoration-warning="connection_state == 'expired'"
                       decoration-muted="connection_state == 'disconnected'"/>
                <field name="pipeline_id"/>
            </list>
        </field>
    </record>

    <record id="view_social_account_search" model="ir.ui.view">
        <field name="name">doorway.social.account.search</field>
        <field name="model">doorway.social.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="platform"/>
                <field name="pipeline_id"/>
                <filter name="filter_tiktok" string="TikTok" domain="[('platform','=','tiktok')]"/>
                <filter name="filter_facebook" string="Facebook" domain="[('platform','=','facebook')]"/>
                <filter name="filter_instagram" string="Instagram" domain="[('platform','=','instagram')]"/>
                <separator/>
                <filter name="filter_disconnected" string="À connecter"
                        domain="[('connection_state','!=','connected')]"/>
                <group>
                    <filter name="group_platform" string="Plateforme" context="{'group_by': 'platform'}"/>
                    <filter name="group_pipeline" string="Marque" context="{'group_by': 'pipeline_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_social_accounts_tiktok" model="ir.actions.act_window">
        <field name="name">Comptes TikTok</field>
        <field name="res_model">doorway.social.account</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('platform', '=', 'tiktok')]</field>
        <field name="context">{'default_platform': 'tiktok'}</field>
    </record>

    <record id="action_social_accounts" model="ir.actions.act_window">
        <field name="name">Comptes connectés</field>
        <field name="res_model">doorway.social.account</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connecter un réseau</p>
            <p>TikTok, Facebook et Instagram apparaissent ici, groupés par plateforme.
               Pour TikTok : Paramètres → Connecter un compte TikTok
               (une autorisation par marque : Coins Marocain, Coins Québec…).</p>
        </field>
    </record>

</odoo>
