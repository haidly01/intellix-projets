<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron import iCal Airbnb toutes les 3 heures -->
    <record id="ir_cron_coins_airbnb_ical_import" model="ir.cron">
        <field name="name">Coins Marocain : import disponibilités Airbnb (iCal)</field>
        <field name="model_id" ref="model_coins_property"/>
        <field name="state">code</field>
        <field name="code">model.cron_import_airbnb_icals()</field>
        <field name="interval_number">3</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
</odoo>
