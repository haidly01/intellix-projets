<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coins_fiche_video_list" model="ir.ui.view">
        <field name="name">coins.fiche_video.list</field>
        <field name="model">coins.fiche_video</field>
        <field name="arch" type="xml">
            <list>
                <field name="ordre_affichage"/>
                <field name="fiche_id"/>
                <field name="titre"/>
                <field name="source"/>
                <field name="uploaded_by"/>
                <field name="statut" widget="badge"
                       decoration-success="statut == 'publiee'"
                       decoration-warning="statut == 'en_attente'"
                       decoration-danger="statut == 'refusee'"/>
                <field name="view_count_7d"/>
                <field name="video_url"/>
                <field name="date_upload"/>
            </list>
        </field>
    </record>

    <record id="view_coins_fiche_video_form" model="ir.ui.view">
        <field name="name">coins.fiche_video.form</field>
        <field name="model">coins.fiche_video</field>
        <field name="arch" type="xml">
            <form string="Vidéo de fiche">
                <sheet>
                    <group>
                        <group>
                            <field name="fiche_id"/>
                            <field name="titre"/>
                            <field name="source"/>
                            <field name="statut"/>
                            <field name="ordre_affichage"/>
                        </group>
                        <group>
                            <field name="video_url"/>
                            <field name="uploaded_by"/>
                            <field name="view_count_7d"/>
                            <field name="date_upload"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_coins_fiche_video" model="ir.actions.act_window">
        <field name="name">Vidéos fiches</field>
        <field name="res_model">coins.fiche_video</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
