<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_coins_activite_booking_form" model="ir.ui.view">
        <field name="name">coins.activite_booking.form</field>
        <field name="model">coins.activite_booking</field>
        <field name="type">form</field>
        <field name="arch" type="xml"><form string="Réservation activité">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="prospect,depot_recu,confirme,realise"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="activite_id"/>
                            <field name="booking_date"/>
                            <field name="service_date"/>
                            <field name="participant_count"/>
                            <field name="source"/>
                        </group>
                        <group string="Économie">
                            <field name="currency_id" invisible="1"/>
                            <field name="unit_sale_price"/>
                            <field name="unit_cost"/>
                            <field name="total_sale_price"/>
                            <field name="total_cost"/>
                            <field name="total_margin" decoration-success="total_margin &gt; 0"/>
                            <field name="payment_method"/>
                            <field name="payment_status"/>
                            <field name="payment_reference" invisible="not payment_method"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form></field>
    </record>

    <record id="view_coins_activite_booking_graph" model="ir.ui.view">
        <field name="name">coins.activite_booking.graph</field>
        <field name="model">coins.activite_booking</field>
        <field name="type">graph</field>
        <field name="arch" type="xml"><graph string="Volume activités" type="bar">
                <field name="activite_id"/>
                <field name="total_margin" type="measure"/>
            </graph></field>
    </record>

    <record id="view_coins_activite_booking_list" model="ir.ui.view">
        <field name="name">coins.activite_booking.list</field>
        <field name="model">coins.activite_booking</field>
        <field name="type">list</field>
        <field name="arch" type="xml"><list>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="activite_id"/>
                <field name="service_date"/>
                <field name="participant_count"/>
                <field name="total_sale_price"/>
                <field name="total_margin"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="source"/>
                <field name="status" widget="badge" decoration-success="status in ('confirme', 'realise')" decoration-warning="status == 'depot_recu'" decoration-danger="status == 'annule'"/>
            </list></field>
    </record>

    <record id="view_coins_activite_booking_pivot" model="ir.ui.view">
        <field name="name">coins.activite_booking.pivot</field>
        <field name="model">coins.activite_booking</field>
        <field name="type">pivot</field>
        <field name="arch" type="xml"><pivot string="Marge activités">
                <field name="activite_id" type="row"/>
                <field name="service_date" interval="month" type="col"/>
                <field name="total_margin" type="measure"/>
                <field name="total_sale_price" type="measure"/>
            </pivot></field>
    </record>

    <record id="view_coins_activite_booking_search" model="ir.ui.view">
        <field name="name">coins.activite_booking.search</field>
        <field name="model">coins.activite_booking</field>
        <field name="type">search</field>
        <field name="arch" type="xml"><search>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="activite_id"/>
                <filter name="confirme" string="Confirmés" domain="[('status', '=', 'confirme')]"/>
                <filter name="realise" string="Réalisés" domain="[('status', '=', 'realise')]"/>
                <group>
                    <filter name="group_act" string="Activité" context="{'group_by': 'activite_id'}"/>
                    <filter name="group_status" string="Statut" context="{'group_by': 'status'}"/>
                    <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                </group>
            </search></field>
    </record>

    <record id="view_coins_activite_form" model="ir.ui.view">
        <field name="name">coins.activite.form</field>
        <field name="model">coins.activite</field>
        <field name="type">form</field>
        <field name="arch" type="xml"><form string="Activité">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bookings" type="object" class="oe_stat_button" icon="fa-calendar" invisible="not is_bookable">
                            <field name="booking_count" widget="statinfo" string="Réservations"/>
                        </button>
                        <button name="action_open_viator_link" type="object" class="oe_stat_button" icon="fa-external-link" invisible="activity_type != 'viator_reference'">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Lien Viator</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Réf. Viator" bg_color="text-bg-info" invisible="activity_type != 'viator_reference'"/>
                    <widget name="web_ribbon" title="Non réservable" bg_color="text-bg-secondary" invisible="is_bookable"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nom de l'activité"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="activity_type"/>
                            <field name="category"/>
                            <field name="badge_categorie"/>
                            <field name="is_vip_catalogue"/>
                            <field name="operator"/>
                            <field name="duration"/>
                            <field name="active"/>
                            <field name="is_bookable" readonly="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="public_price"/>
                            <field name="partner_price" invisible="activity_type == 'viator_reference'"/>
                            <field name="estimated_margin" invisible="activity_type == 'viator_reference'" decoration-success="estimated_margin &gt; 0"/>
                            <field name="viator_affiliate_link" invisible="activity_type != 'viator_reference'" widget="url"/>
                            <field name="blog_article_link" widget="url"/>
                            <field name="partner_id" invisible="activity_type == 'viator_reference'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="desc">
                            <field name="description" nolabel="1" placeholder="Description, logistique, points d'attention…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form></field>
    </record>

    <record id="view_coins_activite_kanban" model="ir.ui.view">
        <field name="name">coins.activite.kanban</field>
        <field name="model">coins.activite</field>
        <field name="type">kanban</field>
        <field name="arch" type="xml"><kanban default_group_by="activity_type" class="o_kanban_mobile">
                <field name="name"/>
                <field name="category"/>
                <field name="operator"/>
                <field name="public_price"/>
                <field name="is_bookable"/>
                <field name="activity_type"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div class="text-muted">
                                <field name="category"/> · <field name="operator"/>
                            </div>
                            <div t-if="record.public_price.raw_value">
                                <field name="public_price"/>
                            </div>
                            <span t-if="!record.is_bookable.raw_value" class="badge text-bg-secondary">Affiliation</span>
                        </div>
                    </t>
                </templates>
            </kanban></field>
    </record>

    <record id="view_coins_activite_list" model="ir.ui.view">
        <field name="name">coins.activite.list</field>
        <field name="model">coins.activite</field>
        <field name="type">list</field>
        <field name="arch" type="xml"><list>
                <field name="name"/>
                <field name="activity_type" decoration-info="activity_type == 'viator_reference'" decoration-success="activity_type == 'privatif_operee'" widget="badge"/>
                <field name="category"/>
                <field name="operator"/>
                <field name="public_price"/>
                <field name="partner_price"/>
                <field name="estimated_margin"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_bookable" column_invisible="1"/>
                <field name="booking_count"/>
            </list></field>
    </record>

    <record id="view_coins_activite_search" model="ir.ui.view">
        <field name="name">coins.activite.search</field>
        <field name="model">coins.activite</field>
        <field name="type">search</field>
        <field name="arch" type="xml"><search>
                <field name="name"/>
                <field name="category"/>
                <filter name="bookable" string="Réservables" domain="[('is_bookable', '=', True)]"/>
                <filter name="viator" string="Réf. Viator" domain="[('activity_type', '=', 'viator_reference')]"/>
                <filter name="privatif" string="Privatif" domain="[('activity_type', 'in', ('privatif_operee', 'privatif_partenaire'))]"/>
                <separator/>
                <filter name="archived" string="Archivés" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'activity_type'}"/>
                    <filter name="group_cat" string="Catégorie" context="{'group_by': 'category'}"/>
                    <filter name="group_op" string="Opérateur" context="{'group_by': 'operator'}"/>
                </group>
            </search></field>
    </record>

</odoo>