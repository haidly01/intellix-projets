<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coins_partner_activity_list" model="ir.ui.view">
        <field name="name">coins.partner_activity.list</field>
        <field name="model">coins.partner_activity</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category"/>
                <field name="contact_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="relation_type"/>
                <field name="signup_channel"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'en_attente'"
                       decoration-info="state == 'prospected'"
                       decoration-success="state == 'signed'"/>
            </list>
        </field>
    </record>

    <record id="view_coins_partner_activity_form" model="ir.ui.view">
        <field name="name">coins.partner_activity.form</field>
        <field name="model">coins.partner_activity</field>
        <field name="arch" type="xml">
            <form string="Partenaire">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="en_attente,prospected,discussing,signed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="relation_type"/>
                            <field name="signup_channel"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="contact_name"/>
                            <field name="partner_id"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="commission_pct"/>
                        </group>
                    </group>
                    <group string="Inscription libre-service">
                        <field name="description" colspan="2"/>
                        <field name="image_1920" widget="image" class="oe_avatar"/>
                        <field name="video_url"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_coins_partner_activity" model="ir.actions.act_window">
        <field name="name">Partenaires</field>
        <field name="res_model">coins.partner_activity</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
