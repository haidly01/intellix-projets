<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19 : res.groups.privilege remplace category_id sur res.groups -->
    <record id="module_category_coins" model="ir.module.category">
        <field name="name">Coins Marocain</field>
        <field name="sequence">50</field>
    </record>

    <record id="res_groups_privilege_coins" model="res.groups.privilege">
        <field name="name">Coins Marocain</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="module_category_coins"/>
    </record>

    <record id="group_coins_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_coins"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_coins_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_coins"/>
        <field name="implied_ids" eval="[(4, ref('group_coins_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_coins_agent_terrain" model="res.groups">
        <field name="name">Agent terrain</field>
        <field name="sequence">15</field>
        <field name="privilege_id" ref="res_groups_privilege_coins"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
