# Jason Thomas Assurance — IntelliX DEV
# 1) DNS A jasonthomas.intellixcrm.com → 187.124.50.69
# 2) sudo cp ... /etc/nginx/sites-available/jasonthomas.intellixcrm.com
# 3) sudo ln -sf ... sites-enabled && sudo nginx -t && sudo systemctl reload nginx
# 4) sudo certbot --nginx -d jasonthomas.intellixcrm.com

upstream odoo_jt {
    server 127.0.0.1:8069;
}
upstream odoo_jt_bus {
    server 127.0.0.1:8072;
}

server {
    listen 80;
    server_name jasonthomas.intellixcrm.com;

    client_max_body_size 1024M;
    proxy_read_timeout 720s;
    proxy_connect_timeout 720s;
    proxy_send_timeout 720s;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Connection "close";
    proxy_redirect off;

    location /websocket {
        proxy_pass http://odoo_jt_bus;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /longpolling {
        proxy_pass http://odoo_jt_bus;
    }

    location = / {
        return 302 /web/login;
    }

    location / {
        proxy_pass http://odoo_jt;
    }
}
