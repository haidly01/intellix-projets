<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="portal_contact" name="JT Portal — Contact">
    <t t-call="jt_client_portal.portal_layout">
      <div class="jt-page-header">
        <h1>Contacter Jason</h1>
      </div>
      <div class="jt-detail-card">
        <form method="post" class="jt-contact-form">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <div class="mb-3">
            <label class="form-label">Sujet</label>
            <input type="text" name="sujet" class="form-control" required="required" placeholder="Renouvellement, nouvelle couverture..."/>
          </div>
          <div class="mb-3">
            <label class="form-label">Message</label>
            <textarea name="message" class="form-control" rows="6" required="required" placeholder="Votre message..."/>
          </div>
          <button type="submit" class="jt-btn-primary">Envoyer</button>
        </form>
      </div>
    </t>
  </template>

  <template id="portal_contact_merci" name="JT Portal — Merci">
    <t t-call="jt_client_portal.portal_layout">
      <div class="jt-hero">
        <h1>Merci !</h1>
        <p class="jt-hero-sub">Votre message a été transmis à Jason Thomas. Il vous répondra sous peu.</p>
      </div>
      <a t-attf-href="/portail/#{token}" class="jt-btn-secondary">Retour à l'accueil</a>
    </t>
  </template>
</odoo>
