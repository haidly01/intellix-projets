<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_coins_quebec" model="ir.module.category">
        <field name="name">Coins Québec</field>
        <field name="sequence">51</field>
    </record>
    <record id="res_groups_privilege_coins_quebec" model="res.groups.privilege">
        <field name="name">Coins Québec</field>
        <field name="sequence">51</field>
        <field name="category_id" ref="module_category_coins_quebec"/>
    </record>
    <record id="group_coins_quebec_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_coins_quebec"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="group_coins_quebec_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_coins_quebec"/>
        <field name="implied_ids" eval="[(4, ref('group_coins_quebec_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_coins_quebec_commercant" model="res.groups">
        <field name="name">Commerçant portail Mon Coin</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="comment">Voir uniquement sa fiche coins.quebec.partenariat.</field>
    </record>

    <record id="rule_cq_partenariat_portal" model="ir.rule">
        <field name="name">Mon Coin : sa fiche seulement</field>
        <field name="model_id" ref="model_coins_quebec_partenariat"/>
        <field name="domain_force">[('portal_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_coins_quebec_commercant'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_cq_service_portal" model="ir.rule">
        <field name="name">Mon Coin : ses services</field>
        <field name="model_id" ref="model_coins_quebec_partenariat_service"/>
        <field name="domain_force">[('partenariat_id.portal_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_coins_quebec_commercant'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_cq_offer_portal" model="ir.rule">
        <field name="name">Mon Coin : ses forfaits</field>
        <field name="model_id" ref="model_coins_quebec_partenariat_forfait"/>
        <field name="domain_force">[('partenariat_id.portal_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_coins_quebec_commercant'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_cq_photo_portal" model="ir.rule">
        <field name="name">Mon Coin : ses photos</field>
        <field name="model_id" ref="model_coins_quebec_partenariat_photo"/>
        <field name="domain_force">[('partenariat_id.portal_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_coins_quebec_commercant'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_cq_boost_portal" model="ir.rule">
        <field name="name">Mon Coin : ses boosts</field>
        <field name="model_id" ref="model_coins_quebec_boost_request"/>
        <field name="domain_force">[('partenariat_id.portal_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_coins_quebec_commercant'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
