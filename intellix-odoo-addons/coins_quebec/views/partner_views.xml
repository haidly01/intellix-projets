<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_cq_partner_action" model="ir.actions.act_window">
        <field name="name">Partenaires</field>
        <field name="path">cq-partenaires</field>
        <field name="res_model">coins.quebec.partner.activity</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_cq_partner_list" model="ir.ui.view">
        <field name="name">coins.quebec.partner.activity.list</field>
        <field name="model">coins.quebec.partner.activity</field>
        <field name="arch" type="xml">
            <list class="o_cq_list">
                    <field name="name"/>
                    <field name="category"/>
                    <field name="city"/>
                    <field name="state"/>
                    <field name="commission_pct"/>
                    <field name="negotiated_rate"/>
                    <field name="currency_id"/>
            </list>
        </field>
    </record>
    <record id="action_cq_partner_form" model="ir.ui.view">
        <field name="name">coins.quebec.partner.activity.form</field>
        <field name="model">coins.quebec.partner.activity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                    <group string="Partenaire">
                        <field name="name"/>
                        <field name="category"/>
                        <field name="relation_type"/>
                        <field name="state"/>
                        <field name="active"/>
                    </group>
                    <group string="Contact">
                        <field name="contact_name"/>
                        <field name="partner_id"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="city"/>
                    </group>
                    <group string="Commercial CAD">
                        <field name="currency_id"/>
                        <field name="negotiated_rate"/>
                        <field name="commission_pct"/>
                        <field name="notes"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
