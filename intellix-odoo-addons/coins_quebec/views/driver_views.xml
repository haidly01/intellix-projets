<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_cq_driver_action" model="ir.actions.act_window">
        <field name="name">Chauffeurs</field>
        <field name="path">cq-chauffeurs</field>
        <field name="res_model">coins.quebec.driver</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_cq_driver_list" model="ir.ui.view">
        <field name="name">coins.quebec.driver.list</field>
        <field name="model">coins.quebec.driver</field>
        <field name="arch" type="xml">
            <list>
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="state"/>
                    <field name="frais_par_course"/>
                    <field name="solde_du_jour"/>
                    <field name="currency_id"/>
            </list>
        </field>
    </record>
    <record id="action_cq_driver_form" model="ir.ui.view">
        <field name="name">coins.quebec.driver.form</field>
        <field name="model">coins.quebec.driver</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                    <group string="Chauffeur">
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="state"/>
                        <field name="active"/>
                        <field name="rating"/>
                    </group>
                    <group string="Paiement CAD">
                        <field name="currency_id"/>
                        <field name="frais_par_course"/>
                        <field name="solde_du_jour"/>
                        <field name="rib_coordonnees"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_cq_driver_contrat_action" model="ir.actions.act_window">
