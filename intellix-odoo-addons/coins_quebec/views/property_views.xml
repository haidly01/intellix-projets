<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_cq_property_action" model="ir.actions.act_window">
        <field name="name">Biens</field>
        <field name="path">cq-biens</field>
        <field name="res_model">coins.quebec.property</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_demo', '=', False)]</field>
    </record>
    <record id="action_cq_property_list" model="ir.ui.view">
        <field name="name">coins.quebec.property.list</field>
        <field name="model">coins.quebec.property</field>
        <field name="arch" type="xml">
            <list class="o_cq_list">
                    <field name="name"/>
                    <field name="property_type"/>
                    <field name="city"/>
                    <field name="state"/>
                    <field name="tarif_nuit"/>
                    <field name="currency_id"/>
                    <field name="commission_pct"/>
            </list>
        </field>
    </record>
    <record id="action_cq_property_form" model="ir.ui.view">
        <field name="name">coins.quebec.property.form</field>
        <field name="model">coins.quebec.property</field>
        <field name="arch" type="xml">
            <form class="o_cq_form">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="negotiating,active,inactive"/>
                </header>
                <sheet>
                    <div class="o_cq_banner">Coins Québec · Biens · CAD</div>
                    <group>
                    <group string="Identité">
                        <field name="name"/>
                        <field name="property_type"/>
                        <field name="state"/>
                        <field name="category_ids"/>
                        <field name="active"/>
                    </group>
                    <group string="Lieu">
                        <field name="street"/>
                        <field name="district"/>
                        <field name="city"/>
                        <field name="province"/>
                        <field name="country_id"/>
                    </group>
                    <group string="Contact">
                        <field name="owner_id"/>
                        <field name="phone"/>
                        <field name="email"/>
                    </group>
                    <group string="Tarifs CAD">
                        <field name="currency_id"/>
                        <field name="tarif_nuit"/>
                        <field name="tarif_privatisation_jour"/>
                        <field name="commission_pct"/>
                        <field name="nb_chambres"/>
                        <field name="location_chambre_unite"/>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_cq_property_category" model="ir.actions.act_window">
        <field name="name">Catégories</field>
        <field name="path">cq-categories</field>
        <field name="res_model">coins.quebec.property.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
