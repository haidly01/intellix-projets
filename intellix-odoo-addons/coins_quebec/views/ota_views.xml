        <field name="arch" type="xml">
            <list>
                    <field name="name"/>
                    <field name="property_id"/>
                    <field name="channex_property_id"/>
                    <field name="active"/>
            </list>
        </field>
    </record>
    <record id="action_cq_channex_mapping_form" model="ir.ui.view">
        <field name="name">coins.quebec.channex.mapping.form</field>
        <field name="model">coins.quebec.channex.mapping</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                    <group string="Mapping">
                        <field name="name"/>
                        <field name="property_id"/>
                        <field name="channex_property_id"/>
                        <field name="active"/>
                    </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cq_channex_calendar_action" model="ir.actions.act_window">
