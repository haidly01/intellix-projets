                        <field name="currency_id"/>
                        <field name="price"/>
                        <field name="closed"/>
                    </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cq_channex_push_action" model="ir.actions.act_window">
