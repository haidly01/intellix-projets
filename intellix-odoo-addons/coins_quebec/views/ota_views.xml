<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_cq_channex_config_action" model="ir.actions.act_window">
        <field name="name">Connexion Channex</field>
        <field name="path">cq-channex-config</field>
        <field name="res_model">coins.quebec.channex.config</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_cq_channex_config_list" model="ir.ui.view">
        <field name="name">coins.quebec.channex.config.list</field>
        <field name="model">coins.quebec.channex.config</field>
        <field name="arch" type="xml">
            <list>
                    <field name="name"/>
                    <field name="api_url"/>
                    <field name="active"/>
            </list>
        </field>
    </record>
    <record id="action_cq_channex_config_form" model="ir.ui.view">
        <field name="name">coins.quebec.channex.config.form</field>
        <field name="model">coins.quebec.channex.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                    <group string="Connexion">
                        <field name="name"/>
                        <field name="api_url"/>
                        <field name="api_key"/>
                        <field name="active"/>
                        <field name="notes"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_cq_channex_mapping_action" model="ir.actions.act_window">
        <field name="name">Mapping propriétés</field>
        <field name="path">cq-channex-mapping</field>
