<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_cq_prestataire_action" model="ir.actions.act_window">
        <field name="name">Prestataires CRM</field>
        <field name="path">cq-prestataires</field>
        <field name="res_model">coins.quebec.prestataire</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_cq_prestataire_list" model="ir.ui.view">
        <field name="name">coins.quebec.prestataire.list</field>
        <field name="model">coins.quebec.prestataire</field>
        <field name="arch" type="xml">
            <list>
                    <field name="name"/>
                    <field name="category"/>
                    <field name="city"/>
                    <field name="tarif"/>
                    <field name="currency_id"/>
            </list>
        </field>
    </record>
    <record id="action_cq_prestataire_form" model="ir.ui.view">
        <field name="name">coins.quebec.prestataire.form</field>
        <field name="model">coins.quebec.prestataire</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                    <group string="Prestataire">
                        <field name="name"/>
                        <field name="category"/>
                        <field name="partner_id"/>
                        <field name="tag_ids"/>
                        <field name="active"/>
                    </group>
                    <group string="Contact">
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="city"/>
                    </group>
                    <group string="Tarif CAD">
                        <field name="currency_id"/>
                        <field name="tarif"/>
                        <field name="notes"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_cq_prestataire_tag" model="ir.actions.act_window">
        <field name="name">Tags prestataires</field>
        <field name="path">cq-prestataire-tags</field>
        <field name="res_model">coins.quebec.prestataire.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
