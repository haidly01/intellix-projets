<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cq_book_rdv_wizard" model="ir.ui.view">
        <field name="name">coins.quebec.book.rdv.wizard.form</field>
        <field name="model">coins.quebec.book.rdv.wizard</field>
        <field name="arch" type="xml">
            <form string="Planifier une réunion (Martin)" class="o_hiba_book_martin o_cq_martin_wizard">
                <group>
                    <div colspan="2" class="text-muted">
                        Hôte : Martin Houle — calendrier unique.
                        Prénom, nom, téléphones et adresses sont copiés dans le RDV.
                    </div>
                    <field name="partenariat_id" readonly="1"/>
                </group>
                <group string="Contact (suit dans le RDV)">
                    <group>
                        <field name="contact_firstname" placeholder="Prénom"/>
                        <field name="contact_lastname" placeholder="Nom de famille"/>
                    </group>
                </group>
                <group string="Téléphones">
                    <field name="phone_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="label"/>
                            <field name="phone"/>
                        </list>
                    </field>
                </group>
                <group string="Adresses">
                    <field name="address_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="label"/>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="zip"/>
                        </list>
                    </field>
                </group>
                <field name="slot" widget="hiba_martin_slots" nolabel="1"/>
                <group>
                    <field name="start"
                           string="Hors créneau (optionnel)"
                           invisible="slot"/>
                    <field name="note" placeholder="Ce que Martin doit savoir"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Booker"
                            class="btn-primary"
                            invisible="not slot and not start"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
