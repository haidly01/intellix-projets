<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="crm_team_cq_partenariats" model="crm.team">
        <field name="name">Coins Québec — Partenariats</field>
        <field name="sequence">12</field>
        <field name="use_leads" eval="False"/>
        <field name="use_opportunities" eval="True"/>
    </record>
    <record id="crm_team_cq_voyageurs" model="crm.team">
        <field name="name">Coins Québec — Voyageurs</field>
        <field name="sequence">13</field>
        <field name="use_leads" eval="False"/>
        <field name="use_opportunities" eval="True"/>
    </record>

    <record id="stage_cq_p_nouveau" model="crm.stage">
        <field name="name">Nouveau</field>
        <field name="sequence">1</field>
        <field name="team_ids" eval="[(4, ref('crm_team_cq_partenariats'))]"/>
    </record>
    <record id="stage_cq_p_contacte" model="crm.stage">
        <field name="name">Contacté</field>
        <field name="sequence">2</field>
        <field name="team_ids" eval="[(4, ref('crm_team_cq_partenariats'))]"/>
    </record>
    <record id="stage_cq_p_en_rdv" model="crm.stage">
        <field name="name">En RDV</field>
        <field name="sequence">3</field>
        <field name="team_ids" eval="[(4, ref('crm_team_cq_partenariats'))]"/>
    </record>
    <record id="stage_cq_p_suivi" model="crm.stage">
        <field name="name">Suivis</field>
        <field name="sequence">4</field>
        <field name="team_ids" eval="[(4, ref('crm_team_cq_partenariats'))]"/>
    </record>
    <record id="stage_cq_p_entente" model="crm.stage">
        <field name="name">Entente</field>
        <field name="sequence">5</field>
        <field name="team_ids" eval="[(4, ref('crm_team_cq_partenariats'))]"/>
    </record>
    <record id="stage_cq_p_signe" model="crm.stage">
        <field name="name">Gagné</field>
        <field name="sequence">6</field>
        <field name="is_won" eval="True"/>
        <field name="fold" eval="True"/>
        <field name="team_ids" eval="[(4, ref('crm_team_cq_partenariats'))]"/>
    </record>
    <record id="stage_cq_p_perdu" model="crm.stage">
        <field name="name">Perdu</field>
        <field name="sequence">7</field>
        <field name="fold" eval="True"/>
        <field name="team_ids" eval="[(4, ref('crm_team_cq_partenariats'))]"/>
    </record>

    <record id="stage_cq_v_nouveau" model="crm.stage">
        <field name="name">Nouveau</field>
        <field name="sequence">10</field>
        <field name="team_ids" eval="[(4, ref('crm_team_cq_voyageurs'))]"/>
    </record>
    <record id="stage_cq_v_qualifie" model="crm.stage">
        <field name="name">Contacté</field>
        <field name="sequence">20</field>
        <field name="team_ids" eval="[(4, ref('crm_team_cq_voyageurs'))]"/>
    </record>
    <record id="stage_cq_v_entente" model="crm.stage">
        <field name="name">Entente</field>
        <field name="sequence">30</field>
        <field name="team_ids" eval="[(4, ref('crm_team_cq_voyageurs'))]"/>
    </record>
    <record id="stage_cq_v_suivi" model="crm.stage">
        <field name="name">Suivis</field>
        <field name="sequence">40</field>
        <field name="team_ids" eval="[(4, ref('crm_team_cq_voyageurs'))]"/>
    </record>
    <record id="stage_cq_v_reserve" model="crm.stage">
        <field name="name">Gagné</field>
        <field name="sequence">50</field>
        <field name="is_won" eval="True"/>
        <field name="team_ids" eval="[(4, ref('crm_team_cq_voyageurs'))]"/>
    </record>
    <record id="stage_cq_v_perdu" model="crm.stage">
        <field name="name">Perdu</field>
        <field name="sequence">60</field>
        <field name="fold" eval="True"/>
        <field name="team_ids" eval="[(4, ref('crm_team_cq_voyageurs'))]"/>
    </record>
</odoo>
