<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="crm_stage_itex_nouveau" model="crm.stage">
            <field name="name">Nouveau / à pitcher</field>
            <field name="sequence">10</field>
            <field name="fold" eval="False"/>
            <field name="team_ids" eval="[(4, ref('crm_team_itex'))]"/>
        </record>
        <record id="crm_stage_itex_pitch_fait" model="crm.stage">
            <field name="name">Pitch fait</field>
            <field name="sequence">20</field>
            <field name="fold" eval="False"/>
            <field name="team_ids" eval="[(4, ref('crm_team_itex'))]"/>
        </record>
        <record id="crm_stage_itex_interet_confirme" model="crm.stage">
            <field name="name">Intérêt confirmé</field>
            <field name="sequence">30</field>
            <field name="fold" eval="False"/>
            <field name="team_ids" eval="[(4, ref('crm_team_itex'))]"/>
        </record>
        <record id="crm_stage_itex_documentation" model="crm.stage">
            <field name="name">Documentation</field>
            <field name="sequence">40</field>
            <field name="fold" eval="False"/>
            <field name="team_ids" eval="[(4, ref('crm_team_itex'))]"/>
        </record>
        <record id="crm_stage_itex_reporte" model="crm.stage">
