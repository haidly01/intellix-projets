            <field name="sequence">60</field>
            <field name="fold" eval="False"/>
            <field name="team_ids" eval="[(4, ref('crm_team_itex'))]"/>
        </record>
        <record id="crm_stage_itex_adherent" model="crm.stage">
            <field name="name">Adhérent / mensualités</field>
            <field name="sequence">70</field>
            <field name="fold" eval="False"/>
            <field name="is_won" eval="True"/>
            <field name="team_ids" eval="[(4, ref('crm_team_itex'))]"/>
        </record>
        <record id="crm_stage_itex_perdu" model="crm.stage">
            <field name="name">Perdu</field>
            <field name="sequence">80</field>
            <field name="fold" eval="False"/>
