<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_finance_root"
              name="Finance"
              sequence="6"
              action="action_finance_itex_leads"
              web_icon="intellix_finance,static/description/icon.png"
              groups="base.group_user,sales_team.group_sale_salesman,sales_team.group_sale_manager"/>

    <!-- Ancien comparatif Driven / Growth Capital : masqué, données conservées. -->
    <record id="menu_finance_dashboard" model="ir.ui.menu">
        <field name="name">Comparatif Driven / Growth Capital (masqué)</field>
        <field name="parent_id" ref="menu_finance_root"/>
        <field name="action" eval="False"/>
        <field name="active" eval="False"/>
        <field name="sequence">99</field>
    </record>

    <menuitem id="menu_finance_itex"
              name="ITEX"
              parent="menu_finance_root"
              action="action_finance_itex_leads"
              sequence="10"/>

    <menuitem id="menu_finance_itex_dashboard"
              name="Dashboard ITEX"
              parent="menu_finance_itex"
              action="action_finance_itex_partenaires_dashboard"
              sequence="15"/>

    <menuitem id="menu_finance_itex_leads"
              name="Entonnoir ITEX"
              parent="menu_finance_itex"
              action="action_finance_itex_leads"
              sequence="20"/>

    <menuitem id="menu_finance_itex_callbacks"
              name="Rappels Alex ITEX"
              parent="menu_finance_itex"
              action="action_finance_callbacks_itex"
              sequence="25"/>

    <menuitem id="menu_finance_driven"
              name="Driven"
              parent="menu_finance_root"
              action="action_finance_driven_dashboard"
              sequence="20"/>

    <menuitem id="menu_finance_driven_dashboard"
              name="Dashboard Driven"
              parent="menu_finance_driven"
              action="action_finance_driven_dashboard"
              sequence="5"/>

    <menuitem id="menu_finance_driven_funnel"
              name="Entonnoir Driven"
              parent="menu_finance_driven"
              action="action_finance_funnel_driven"
              sequence="10"/>

    <menuitem id="menu_finance_driven_not_qualified"
              name="Non qualifiés Driven"
              parent="menu_finance_driven"
              action="action_finance_not_qualified_driven"
              sequence="20"/>

    <menuitem id="menu_finance_driven_callbacks"
              name="Rappels Alex"
              parent="menu_finance_driven"
              action="action_finance_callbacks_driven"
              sequence="15"/>

    <menuitem id="menu_finance_growth"
              name="Growth Capital"
              parent="menu_finance_root"
              action="action_finance_funnel_growth"
              sequence="30"/>

    <menuitem id="menu_finance_growth_funnel"
              name="Entonnoir Growth Capital"
              parent="menu_finance_growth"
              action="action_finance_funnel_growth"
              sequence="10"/>

    <menuitem id="menu_finance_growth_not_qualified"
              name="Non qualifiés Growth Capital"
              parent="menu_finance_growth"
              action="action_finance_not_qualified_growth"
              sequence="20"/>

    <function model="crm.lead" name="_finance_harden_menus"/>
</odoo>
