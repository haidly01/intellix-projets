<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doorway_call_session_live_list" model="ir.ui.view">
        <field name="name">doorway.call.session.live.list</field>
        <field name="model">doorway.call.session</field>
        <field name="arch" type="xml">
            <list string="Appels en direct" decoration-info="call_status == 'in-progress'"
                  decoration-warning="call_status == 'ringing'">
                <field name="name"/>
                <field name="agent_id"/>
                <field name="lead_id"/>
                <field name="call_status"/>
                <field name="date_start"/>
                <field name="duration"/>
                <field name="transcript" optional="hide"/>
                <button name="action_open_coaching" type="object" string="Coaching"
                        icon="fa-comments" class="btn-primary"/>
            </list>
        </field>
    </record>

    <record id="view_doorway_call_session_form" model="ir.ui.view">
        <field name="name">doorway.call.session.form</field>
        <field name="model">doorway.call.session</field>
        <field name="arch" type="xml">
            <form string="Session d'appel">
                <header>
                    <button name="action_open_coaching" type="object" string="Coaching en direct"
                            class="btn-primary" invisible="not is_live"/>
                    <button name="finalize_call" type="object" string="Clôturer"
                            invisible="not is_live"/>
                    <field name="call_status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="agent_id"/>
                        <field name="lead_id"/>
                        <field name="twilio_call_sid"/>
                        <field name="vicidial_campaign_id"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="duration"/>
                        <field name="is_live" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Transcript">
                            <field name="transcript" nolabel="1"/>
                        </page>
                        <page string="Coaching Claude">
                            <field name="claude_analysis_realtime" nolabel="1"/>
                            <field name="coaching_notes"/>
                        </page>
                        <page string="Rapport">
                            <field name="report_id"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_doorway_call_session_search" model="ir.ui.view">
        <field name="name">doorway.call.session.search</field>
        <field name="model">doorway.call.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="agent_id"/>
                <field name="lead_id"/>
                <field name="twilio_call_sid"/>
                <filter name="live" string="En cours"
                    domain="[('call_status','in',['initiated','ringing','in-progress'])]"/>
                <filter name="completed" string="Terminés"
                    domain="[('call_status','=','completed')]"/>
                <filter name="today" string="Aujourd'hui"
                    domain="[('date_start','&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
            </search>
        </field>
    </record>

    <record id="action_doorway_dashboard_live" model="ir.actions.act_window">
        <field name="name">Monitoring en direct</field>
        <field name="res_model">doorway.call.session</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('call_status', 'in', ['initiated', 'ringing', 'in-progress'])]</field>
        <field name="context">{'search_default_live': 1}</field>
    </record>

    <record id="action_doorway_call_sessions_all" model="ir.actions.act_window">
        <field name="name">Toutes les sessions</field>
        <field name="res_model">doorway.call.session</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
