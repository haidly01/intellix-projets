<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doorway_call_coaching_wizard_form" model="ir.ui.view">
        <field name="name">doorway.call.coaching.wizard.form</field>
        <field name="model">doorway.call.coaching.wizard</field>
        <field name="arch" type="xml">
            <form string="Coaching en direct">
                <group>
                    <field name="session_id" readonly="1"/>
                    <field name="agent_id"/>
                    <field name="lead_id"/>
                    <field name="call_status"/>
                </group>
                <group string="Transcript (temps réel)">
                    <field name="transcript" nolabel="1" readonly="1"/>
                </group>
                <group string="Suggestions Claude">
                    <field name="claude_suggestions" nolabel="1" readonly="1"/>
                </group>
                <group string="Notes superviseur">
                    <field name="supervisor_notes" nolabel="1"/>
                    <field name="transfer_number" placeholder="+15145551234"/>
                </group>
                <footer>
                    <button name="action_refresh_coaching" type="object" string="Actualiser"
                            class="btn-secondary"/>
                    <button name="action_save_notes" type="object" string="Enregistrer notes"
                            class="btn-primary"/>
                    <button name="action_transfer" type="object" string="Transférer"
                            class="btn-secondary"/>
                    <button name="action_end_call" type="object" string="Terminer"
                            class="btn-warning"/>
                    <button name="action_escalate" type="object" string="Escalader"
                            class="btn-danger"/>
                    <button string="Fermer" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
