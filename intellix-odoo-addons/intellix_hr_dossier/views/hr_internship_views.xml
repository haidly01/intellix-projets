<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_internship_tree" model="ir.ui.view">
        <field name="name">hr.internship.list</field>
        <field name="model">hr.internship</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="establishment"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="supervisor_id"/>
            </list>
        </field>
    </record>

    <record id="view_hr_internship_form" model="ir.ui.view">
        <field name="name">hr.internship.form</field>
        <field name="model">hr.internship</field>
        <field name="arch" type="xml">
            <form string="Stage">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="establishment"/>
                            <field name="supervisor_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Mission">
                        <field name="mission_description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_internship" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">hr.internship</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
