<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_hr_dossier" model="ir.ui.view">
        <field name="name">res.company.form.hr.dossier</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Attestations RH (Maroc)" name="hr_dossier_attestations">
                    <group>
                        <group string="Signataire">
                            <field name="x_hr_signatory_name"/>
                            <field name="x_hr_signatory_title"/>
                            <field name="x_attestation_city"/>
                        </group>
                        <group string="Identifiants légaux">
                            <field name="x_cnss_employer_number"/>
                            <field name="x_morocco_ice"/>
                            <field name="x_morocco_rc"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
