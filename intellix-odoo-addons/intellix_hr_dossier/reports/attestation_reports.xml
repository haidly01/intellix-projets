<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_attestation_travail" model="ir.actions.report">
        <field name="name">Attestation de travail</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">intellix_hr_dossier.report_attestation_travail</field>
        <field name="report_file">intellix_hr_dossier.report_attestation_travail</field>
        <field name="print_report_name">'Attestation travail - %s' % (object.name)</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_attestation_a4"/>
        <field name="group_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

